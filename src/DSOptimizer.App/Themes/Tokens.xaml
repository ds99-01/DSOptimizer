<!--
  Tokeny wyglądu „Grafit”.
  Pasek marki i lewa kolumna mają stałe kolory grafitu (oba motywy); treść używa pędzli motywu WPF-UI.
  Wartości przeniesione 1:1 z makiety wzorcowej.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:model="clr-namespace:DSOptimizer.Core.Model;assembly=DSOptimizer.Core"
                    xmlns:views="clr-namespace:DSOptimizer.App.Views">

  <!-- Czcionka marki (SIL OFL 1.1, THIRD_PARTY_NOTICES.md) -->
  <FontFamily x:Key="BrandFont">pack://application:,,,/Assets/Fonts/#Hanken Grotesk</FontFamily>
  <!-- Kontrolki WPF-UI biorą czcionkę z tego klucza -->
  <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Assets/Fonts/#Hanken Grotesk</FontFamily>
  <FontFamily x:Key="CaptionIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- Kolory -->
  <!--
    Akcent „S4” (cyjan, decyzja autora 2026-10-26, wariant B) zależny od motywu: tu wartości jasnego motywu (motyw startowy App.xaml),
    a ThemeController przy każdej zmianie motywu wpisuje do zasobów aplikacji kolory z Core BrandPalette (jasny #007CA5 + biały tekst,
    ciemny #00A9D4 + ciemny tekst). Dlatego pędzle BrandAccent*/BrandOnAccentBrush bierze się wyłącznie przez DynamicResource
    (pilnuje tego test AppIconTests). Akcent tylko w: zaznaczonym polu wyboru, krawędzi 3 px wiersza w serii, pasku „L” nad dziennikiem,
    głównym przycisku i paskach postępu okna serii; reszta zaznaczeń i fokusu = neutralne pędzle motywu.
  -->
  <Color x:Key="BrandAccentColor">#007CA5</Color>
  <SolidColorBrush x:Key="BrandAccentBrush" Color="#007CA5" />
  <SolidColorBrush x:Key="BrandOnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeadBackgroundBrush" Color="#1C1F22" />
  <SolidColorBrush x:Key="HeadForegroundBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="HeadButtonHoverBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="HeadButtonPressedBrush" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="HeadCloseHoverBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="SideBackgroundBrush" Color="#23272B" />
  <SolidColorBrush x:Key="SideForegroundBrush" Color="#E4E7EA" />
  <SolidColorBrush x:Key="SideCountBrush" Color="#8E969E" />
  <SolidColorBrush x:Key="SideSelectedBrush" Color="#30363B" />
  <SolidColorBrush x:Key="SideHoverBrush" Color="#2A2F33" />
  <!-- Linia nad pozycją „Ustawienia” przypiętą na dole menu -->
  <SolidColorBrush x:Key="SideDividerBrush" Color="#33393E" />
  <!-- Znacznik wybranej pozycji menu: leży na ciemnej ramie w obu motywach, więc jeden cyjan (BrandPalette.NavMarker), nie akcent treści -->
  <SolidColorBrush x:Key="NavMarkerBrush" Color="#00A9D4" />

  <!-- Tekst -->
  <Style x:Key="SubText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Tytuły strony i pozycji: zawijanie po słowach, słowo szersze niż miejsce kończy się wielokropkiem (nigdy łamanie po literze) -->
  <Style x:Key="PageTitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="WrapWithOverflow" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SectionHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="ItemTitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="WrapWithOverflow" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="DetailTitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="DetailKeyText" TargetType="TextBlock" BasedOn="{StaticResource SubText}">
    <Setter Property="Margin" Value="0,0,16,5" />
  </Style>
  <Style x:Key="DetailValueText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SummaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <!-- Panel szczegółów: większy odstęp wierszy (ok. 1,4× rozmiaru) w opisach „Co zyskasz”, „Co zmienia”, ostrzeżeniach i szczegółach -->
  <Style x:Key="DetailBodyText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>
  <Style x:Key="DetailSummaryText" TargetType="TextBlock" BasedOn="{StaticResource SummaryText}">
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <!--
    Przyciski (wariant B, decyzja autora): wysokość 28, padding 12,0, promień 3, 13 Medium.
    Główny: akcent, tekst BrandOnAccentBrush, bez obrysu. Drugorzędny: ControlFillColorSecondary + obrys 1 px ControlStrokeColorDefault.
    Stany: najechanie (główny BrandAccentHoverBrush, drugorzędny ControlFillColorTertiary), wciśnięcie głównego BrandAccentPressedBrush
    (kolory obu motywów w Core BrandPalette),
    wyłączony = krycie 0,45, fokus klawiatury = ramka 2 px w kolorze tekstu poza przyciskiem.
  -->
  <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="#006D93" />
  <SolidColorBrush x:Key="BrandAccentPressedBrush" Color="#005E82" />
  <Style x:Key="BrandFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="4" RadiusY="4" StrokeThickness="2" SnapsToDevicePixels="True"
                     Stroke="{DynamicResource TextFillColorPrimaryBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fokus klawiatury na wierszu listy (pozycje, historia): ramka 2 px w kolorze tekstu wewnątrz wiersza (wiersz ma pełną szerokość,
       ramka na zewnątrz ucięłaby się na krawędzi listy) -->
  <Style x:Key="RowFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" RadiusX="2" RadiusY="2" StrokeThickness="2" SnapsToDevicePixels="True"
                     Stroke="{DynamicResource TextFillColorPrimaryBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fokus klawiatury w menu (ciemna kolumna w obu motywach): ramka 2 px w kolorze tekstu menu wewnątrz pozycji -->
  <Style x:Key="NavFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="2" RadiusX="2" RadiusY="2" StrokeThickness="2" SnapsToDevicePixels="True"
                     Stroke="{StaticResource SideForegroundBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Face" Height="28" Padding="12,0" CornerRadius="3" Background="{DynamicResource BrandAccentBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <views:BrandIcon x:Name="Icon" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="16" Margin="0,0,7,0"
                               Foreground="{DynamicResource BrandOnAccentBrush}" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource BrandOnAccentBrush}" FontWeight="Medium" FontSize="13" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource BrandAccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource BrandAccentPressedBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Face" Height="28" Padding="12,0" CornerRadius="3" BorderThickness="1"
                  Background="{DynamicResource ControlFillColorSecondaryBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <views:BrandIcon x:Name="Icon" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="16" Margin="0,0,7,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Medium" FontSize="13" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Przycisk tekstowy (link), np. „Wyczyść” -->
  <Style x:Key="TextLinkButton" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocusVisual}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Root" Background="Transparent" Padding="2,4">
            <StackPanel Orientation="Horizontal">
              <views:BrandIcon x:Name="Icon" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="16" Margin="0,0,6,0"
                               Foreground="{Binding Foreground, ElementName=Label}" VerticalAlignment="Center" />
              <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13.5" FontWeight="Normal"
                         TextDecorations="Underline" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Mała ikona-przycisk w tekście (np. „Kopiuj ścieżkę” w dzienniku); Content = glif Segoe Fluent Icons -->
  <Style x:Key="InlineIconButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent" Padding="4,1" CornerRadius="2">
            <TextBlock x:Name="Glyph" FontFamily="{StaticResource CaptionIconFont}" FontSize="12" FontWeight="Normal"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- „Szczegóły techniczne” w panelu szczegółów (spec opisów 2026-10-26): nagłówek = SectionHeaderText + strzałka Segoe Fluent Icons
       po prawej stronie tekstu (E76C zwinięte, E70D rozwinięte), kursor ręki. Bez tła, ramki, karty i paska z boku, bez ozdobników (uwagi autora)
       i bez akcentu – kolory tekstu neutralne. Fokus klawiatury na nagłówku = BrandFocusVisual; Enter i Spacja
       przełączają (ToggleButton). Treść pod nagłówkiem tylko po rozwinięciu. -->
  <Style x:Key="TechnicalDetailsExpander" TargetType="Expander">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="HeaderToggle" HorizontalAlignment="Left" Cursor="Hand" Content="{TemplateBinding Header}"
                          FocusVisualStyle="{StaticResource BrandFocusVisual}"
                          AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <StackPanel Orientation="Horizontal" Background="Transparent">
                    <TextBlock Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"
                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    <TextBlock x:Name="Chevron" Margin="8,2,0,0" VerticalAlignment="Center" FontFamily="{StaticResource CaptionIconFont}"
                               FontSize="10" Text="&#xE76C;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite" Margin="0,8,0,0" Visibility="Collapsed" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dziennik: tekst tylko do odczytu, bez ramki i tła pola tekstowego (sam ScrollViewer z dokumentem) -->
  <Style x:Key="LogTextBox" TargetType="RichTextBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocusVisual}" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsDocumentEnabled" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RichTextBox">
          <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                        HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Uchwyt wysokości dziennika: linia podziału z krótkim paskiem na środku -->
  <Style x:Key="LogSplitter" TargetType="GridSplitter">
    <Setter Property="Height" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ResizeDirection" Value="Rows" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Grid Background="Transparent">
            <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Border x:Name="Grip" Width="48" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Grip" Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Przyciski okna na pasku marki (ikony Segoe Fluent Icons) -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Normal"
                       FontFamily="{StaticResource CaptionIconFont}" Foreground="{StaticResource HeadForegroundBrush}"
                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource HeadButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource HeadButtonPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Normal"
                       FontFamily="{StaticResource CaptionIconFont}" Foreground="{StaticResource HeadForegroundBrush}"
                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource HeadCloseHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pole wyboru do operacji zbiorczej: 18×18, obrys 1,5 px, zaznaczone = akcent + znacznik BrandOnAccentBrush -->
  <Style x:Key="BrandCheckBox" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocusVisual}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="Root" Width="18" Height="18" Background="Transparent">
            <Border x:Name="Box" CornerRadius="2" BorderThickness="1.5"
                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" />
            <Path x:Name="Mark" Data="M4,9 L7.5,12.5 L14,5.5" Stroke="{DynamicResource BrandOnAccentBrush}"
                  StrokeThickness="2" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandAccentBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Znacznik akcji i panelu: trójkąt „uruchom” -->
  <DataTemplate x:Key="RunMarkerTemplate">
    <!-- Nazwa „RunIcon” rozpoznaje MainWindow.ClassifyClickTarget: klik w ▶ uruchamia akcję. Przezroczyste tło = większy cel kliknięcia.
         Podpowiedź z zasobu ustawianego po wyborze języka (Gui/ThemeTexts). -->
    <Grid x:Name="RunIcon" Background="Transparent" Cursor="Hand" MinHeight="22" ToolTip="{DynamicResource ThemeRunToolTip}">
      <Path Data="M0,0 L9,5 L0,10 Z" Fill="{DynamicResource TextFillColorSecondaryBrush}" Margin="1,0,0,0"
            VerticalAlignment="Center" HorizontalAlignment="Left" />
    </Grid>
  </DataTemplate>

  <!-- Wskaźnik ryzyka: trzy kreski 4×11; bezpieczne 1, ostrożnie 2, eksperymentalne 3 (trzecia w kolorze krytycznym) -->
  <Style x:Key="RiskSegment" TargetType="Rectangle">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Fill" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
  </Style>
  <DataTemplate x:Key="RiskMeterTemplate">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Rectangle x:Name="Seg1" Style="{StaticResource RiskSegment}" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
      <Rectangle x:Name="Seg2" Style="{StaticResource RiskSegment}" />
      <Rectangle x:Name="Seg3" Style="{StaticResource RiskSegment}" />
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding}" Value="{x:Static model:RiskLevel.Caution}">
        <Setter TargetName="Seg2" Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding}" Value="{x:Static model:RiskLevel.Experimental}">
        <Setter TargetName="Seg2" Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter TargetName="Seg3" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Lista kategorii (lewa kolumna): wiersz 38 px, zaznaczenie = tło + pasek 4 px NavMarkerBrush -->
  <Style x:Key="NavListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <!-- Nazwa pozycji dla czytnika ekranu także w menu zwiniętym do ikon (VM pozycji menu mają właściwość Name) -->
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          <Setter Property="FocusVisualStyle" Value="{StaticResource NavFocusVisual}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Grid x:Name="Root" Height="38" Background="Transparent">
                  <Rectangle x:Name="Bar" Width="4" HorizontalAlignment="Left" Fill="{StaticResource NavMarkerBrush}"
                             Visibility="Collapsed" />
                  <ContentPresenter />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SideHoverBrush}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SideSelectedBrush}" />
                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Wiersz listy pozycji (kontener ItemListBox; strona „Instalacja” bierze go też wprost dla wierszy aplikacji) -->
  <Style x:Key="ItemListBoxItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <!-- Nazwa wiersza dla czytnika ekranu: ItemViewModel i HistoryRowViewModel mają AutomationName -->
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}" />
    <!-- Tab z zaznaczonego wiersza przechodzi przez jego pole wyboru, potem wychodzi z listy (ListBox = Once) -->
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <StackPanel>
            <Border x:Name="Row" Background="Transparent">
              <ContentPresenter />
            </Border>
            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lista pozycji (środek): bez kart, cienka linia pod wierszem, zaznaczony wiersz z delikatnym tłem -->
  <Style x:Key="ItemListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Odstęp na pasek przewijania WPF-UI, który rysuje się nad treścią -->
            <ItemsPresenter Margin="0,0,12,0" />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ItemListBoxItem}" />
  </Style>
  <!--
    Pole wyszukiwania (zwykły TextBox): wysokość 30, promień 3, obrys 1 px; fokus = obrys akcentu.
    Z lewej lupa, przy pustym polu tekst zastępczy i podpowiedź „Ctrl+F”, przy niepustym przycisk czyszczenia.
    Przycisk czyszczenia woła ClearSearchCommand z DataContext pola (MainViewModel albo AppsViewModel); Esc robi to samo (KeyBinding w polu).
    Tag = tekst zastępczy, podaje go każde pole (okno główne, „Aplikacje”, „Instalacja”); „Ctrl+F” i teksty przycisku czyszczenia
    z zasobów ustawianych po wyborze języka (Gui/ThemeTexts) – styl powstaje, zanim jest wybrany język.
  -->
  <Style x:Key="SearchTextBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Field" Height="30" CornerRadius="3" BorderThickness="1"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
            <Grid Margin="9,0,6,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <views:BrandIcon Kind="Search" Size="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Grid Grid.Column="1" Margin="8,0,0,0">
                <TextBlock x:Name="Placeholder" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                           IsHitTestVisible="False" Visibility="Collapsed" />
                <!-- Margines -2: wewnętrzny odstęp TextBoxView, żeby tekst stał tam, gdzie tekst zastępczy -->
                <ScrollViewer x:Name="PART_ContentHost" Margin="-2,0,0,0" VerticalAlignment="Center" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              </Grid>
              <TextBlock x:Name="Shortcut" Grid.Column="2" Margin="6,0,2,0" FontSize="12" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{DynamicResource ThemeSearchShortcut}" Visibility="Collapsed" />
              <Button x:Name="ClearButton" Grid.Column="2" Margin="6,0,0,0" Focusable="False" Cursor="Arrow"
                      Command="{Binding ClearSearchCommand}" ToolTip="{DynamicResource ThemeSearchClearToolTip}"
                      AutomationProperties.Name="{DynamicResource ThemeSearchClearName}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Width="22" Height="22" CornerRadius="2" Background="Transparent">
                      <TextBlock FontFamily="{StaticResource CaptionIconFont}" FontSize="10" Text="&#xE711;"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
              <Setter TargetName="Shortcut" Property="Visibility" Value="Visible" />
              <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Trigger>
            <!-- Wyłączone (strona „Instalacja” bez działającego winget): szare tło i obrys, tekst zastępczy wyszarzony, bez „Ctrl+F” -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
              <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
              <Setter TargetName="Shortcut" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Lista rozwijana (filtr „Ryzyko”): pole jak wyszukiwarka z grotem; lista w tle aplikacji z obrysem,
    wybrana pozycja pogrubiona z paskiem akcentu 3 px (render 7-wyszukiwanie).
  -->
  <Style x:Key="BrandComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
            <ContentPresenter x:Name="Label" Margin="12,7" TextElement.FontSize="13" TextElement.FontWeight="Normal"
                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BrandComboBox" TargetType="ComboBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource BrandComboBoxItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Field" Height="30" CornerRadius="3" BorderThickness="1"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Grid Margin="10,0,8,0" IsHitTestVisible="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
              <TextBlock x:Name="Arrow" Grid.Column="1" Margin="12,1,0,0" FontFamily="{StaticResource CaptionIconFont}" FontSize="10"
                         Text="&#xE70D;" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
            <ToggleButton Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" />
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="0,4"
                      CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                      Background="{DynamicResource ApplicationBackgroundBrush}" TextElement.FontFamily="{StaticResource BrandFont}">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;" />
            </Trigger>
            <!-- Nieaktywna lista (np. „Język” w Ustawieniach): krycie jak wyłączone przyciski -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Podpowiedź opisu pozycji (tytuł wiersza): tło paska marki, obrys #3A3F44, 12,5 px z zawijaniem (reszta podpowiedzi bez zmian) -->
  <Style x:Key="BrandToolTip" TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border MaxWidth="280" Padding="10,7" CornerRadius="3" BorderThickness="1" BorderBrush="#3A3F44"
                  Background="{StaticResource HeadBackgroundBrush}">
            <TextBlock FontSize="12.5" FontWeight="Normal" TextWrapping="Wrap" Foreground="{StaticResource HeadForegroundBrush}"
                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
