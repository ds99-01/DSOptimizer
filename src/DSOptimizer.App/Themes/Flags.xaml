<!--
  Flagi okna wyboru języka (LanguageChoiceWindow): obrazy 60×40 (3:2), kolory wpisane literalnie (te same w obu motywach).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Polska: biel i czerwień #DC143C -->
  <DrawingImage x:Key="FlagPolish">
    <DrawingImage.Drawing>
      <DrawingGroup ClipGeometry="M0,0 H60 V40 H0 Z">
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H60 V20 H0 Z" />
        <GeometryDrawing Brush="#DC143C" Geometry="M0,20 H60 V40 H0 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Wielka Brytania: geometria Union Jack przeskalowana do 60×40, czerwone przekątne przesunięte jak w oryginale (przycięte do ćwiartek) -->
  <DrawingImage x:Key="FlagUnitedKingdom">
    <DrawingImage.Drawing>
      <DrawingGroup ClipGeometry="M0,0 H60 V40 H0 Z">
        <GeometryDrawing Brush="#012169" Geometry="M0,0 H60 V40 H0 Z" />
        <GeometryDrawing Geometry="M0,0 L60,40 M60,0 L0,40">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFFFFF" Thickness="8" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <DrawingGroup ClipGeometry="M30,20 H60 V40 Z M30,20 V40 H0 Z M30,20 H0 V0 Z M30,20 V0 H60 Z">
          <GeometryDrawing Geometry="M0,0 L60,40 M60,0 L0,40">
            <GeometryDrawing.Pen>
              <Pen Brush="#C8102E" Thickness="5.33" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
        <GeometryDrawing Geometry="M30,0 V40 M0,20 H60">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFFFFF" Thickness="13.33" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M30,0 V40 M0,20 H60">
          <GeometryDrawing.Pen>
            <Pen Brush="#C8102E" Thickness="8" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
