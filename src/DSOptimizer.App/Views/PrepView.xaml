<UserControl x:Class="DSOptimizer.App.Views.PrepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DSOptimizer.App.Views"
             xmlns:prep="clr-namespace:DSOptimizer.Core.Prep;assembly=DSOptimizer.Core">
  <!-- Układ A (wybór autora 2026-10-21, makieta Tasku 1): jedna kolumna, kroki numerowane jak sekcje Specyfikacji (nagłówek sekcji
       + cienka linia), pod spodem etykieta | wartość ze wspólną kolumną etykiet dla całej strony. Problem = ikona Warning 14 px
       + kolor tekstu wartości (Attention = SystemFillColorCautionBrush, Problem = SystemFillColorCriticalBrush), bez tła, ramek i pasków.
       Linki = TextLinkButton (jak link autora w Ustawieniach): przy nagłówku kroku z prawej, link wiersza (PrepLine.Action) w wierszu. -->
  <UserControl.Resources>
    <!-- Link akcji: styl linku autora (TextLinkButton bez Tag, więc bez ikony); padding 2,4 szablonu zostaje -->
    <DataTemplate x:Key="ActionLink" DataType="{x:Type prep:PrepAction}">
      <Button Style="{StaticResource TextLinkButton}" Margin="14,0,0,0" Content="{Binding Label}"
              Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
    </DataTemplate>
    <ItemsPanelTemplate x:Key="HorizontalPanel">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- Etykieta i wartość: style SpecKey/SpecValue Specyfikacji (DetailKeyText / DetailValueText, odstęp 6 pod linią).
         Kolumna etykiet wspólna dla całej strony, ale najwyżej 180 px: długa nazwa urządzenia z kroku 7 zawija się zamiast odsuwać
         wartości wszystkich kroków -->
    <Style x:Key="PrepKey" TargetType="TextBlock" BasedOn="{StaticResource DetailKeyText}">
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="MaxWidth" Value="180" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="PrepValue" TargetType="TextBlock" BasedOn="{StaticResource DetailValueText}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static prep:PrepTone.Attention}">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static prep:PrepTone.Problem}">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
        <!-- Odczyt w toku: tekst drugorzędny jak „Wczytywanie…” w Specyfikacji (ton zostaje Normal) -->
        <DataTrigger Binding="{Binding Value}" Value="{x:Static prep:PrepText.Loading}">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Ikona problemu (P1 = istniejąca Warning): tylko dla tonów Attention i Problem, w kolorze tekstu wartości -->
    <Style x:Key="ProblemIcon" TargetType="views:BrandIcon" BasedOn="{StaticResource {x:Type views:BrandIcon}}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static prep:PrepTone.Attention}">
          <Setter Property="Visibility" Value="Visible" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static prep:PrepTone.Problem}">
          <Setter Property="Visibility" Value="Visible" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Wiersz: etykieta | [ikona] wartość (+ identyfikator sprzętu pod spodem) | link w wierszu.
         Pusta etykieta (krok 7 „Wszystkie urządzenia mają sterownik.”) zostawia pustą kolumnę etykiet – wartość w tej samej linii pionowej. -->
    <DataTemplate x:Key="LineTemplate" DataType="{x:Type prep:PrepLine}">
      <Grid x:Name="Line" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource PrepKey}" Text="{Binding Label}" />
        <Grid Grid.Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <views:BrandIcon Style="{StaticResource ProblemIcon}" Kind="Warning" Size="14" Margin="0,1,6,0" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Style="{StaticResource PrepValue}" Text="{Binding Value}" />
          <TextBlock x:Name="Detail" Grid.Row="1" Grid.Column="1" Style="{StaticResource SubText}" Margin="0,2,0,0" TextWrapping="Wrap"
                     Text="{Binding Detail}" />
        </Grid>
        <!-- Margines -4: tekst linku w linii z wartością mimo paddingu 2,4 szablonu TextLinkButton -->
        <ContentControl x:Name="LineAction" Grid.Column="2" VerticalAlignment="Top" Margin="0,-4,0,0" Focusable="False"
                        Content="{Binding Action}" ContentTemplate="{StaticResource ActionLink}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
          <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Action}" Value="{x:Null}">
          <Setter TargetName="LineAction" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Krok: numer (drugorzędny) + tytuł sekcji + linki z prawej; cienka linia; wiersze wcięte pod tytuł; notatka tekstem drugorzędnym -->
    <DataTemplate x:Key="StepTemplate" DataType="{x:Type prep:PrepStep}">
      <StackPanel x:Name="Step" Margin="0,20,0,0">
        <Grid MinHeight="26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{Binding Number}" />
          <TextBlock Grid.Column="1" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Text="{Binding Title}" />
          <ItemsControl Grid.Column="2" VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding Actions}"
                        ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource ActionLink}" />
        </Grid>
        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,8" />
        <ItemsControl Margin="24,0,0,0" Focusable="False" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LineTemplate}" />
        <TextBlock x:Name="Note" Style="{StaticResource SubText}" Margin="24,0,0,6" TextWrapping="Wrap" Text="{Binding Note}" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Step" Property="Margin" Value="0" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
          <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- Tytuł + podtytuł (jak Ustawienia) i „Odśwież stan” (jak Specyfikacja); kroki przewijane -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitleText}" Text="{x:Static prep:PrepText.PageTitle}" />
        <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Text="{x:Static prep:PrepText.PageSubtitle}" />
      </StackPanel>
      <Button Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
              Content="{x:Static prep:PrepText.RefreshButton}" Tag="Refresh" Command="{Binding RefreshCommand}" />
    </Grid>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ItemsControl Margin="0,0,12,16" Grid.IsSharedSizeScope="True" Focusable="False"
                    ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
