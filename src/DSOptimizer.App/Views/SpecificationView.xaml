<UserControl x:Class="DSOptimizer.App.Views.SpecificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DSOptimizer.App.Views"
             xmlns:l="clr-namespace:DSOptimizer.App.Gui"
             xmlns:core="clr-namespace:DSOptimizer.Core;assembly=DSOptimizer.Core"
             xmlns:hw="clr-namespace:DSOptimizer.Core.Hardware;assembly=DSOptimizer.Core">
  <UserControl.Resources>
    <views:NonBreakingPhrasesConverter x:Key="NonBreakingPhrases" />
    <views:WidthBelowConverter x:Key="WidthBelow" />

    <!-- Tabela klucz–wartość: style panelu szczegółów; wartość zawija się zamiast ucinać, tylko po przecinku (konwerter) -->
    <Style x:Key="SpecKey" TargetType="TextBlock" BasedOn="{StaticResource DetailKeyText}">
      <Setter Property="Margin" Value="0,0,16,6" />
    </Style>
    <Style x:Key="SpecValue" TargetType="TextBlock" BasedOn="{StaticResource DetailValueText}">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Value}" Value="{x:Static hw:SpecificationFormatter.NoDataText}">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Value}" Value="{x:Static hw:SpecificationFormatter.LoadingText}">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Pole: klucz (kontynuacja bez klucza) | wartość; klucze wyrównane w kolumnie przez SharedSizeGroup -->
    <DataTemplate x:Key="FieldTemplate" DataType="{x:Type hw:SpecField}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Key" Style="{StaticResource SpecKey}" Text="{Binding Key}" />
        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding Value, Converter={StaticResource NonBreakingPhrases}}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsContinuation}" Value="True">
          <Setter TargetName="Key" Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Grupa: nagłówek sekcji + cienka linia + pola; pierwsza grupa kolumny bez odstępu u góry -->
    <DataTemplate x:Key="GroupTemplate" DataType="{x:Type hw:SpecGroup}">
      <StackPanel x:Name="Group" Margin="0,14,0,0">
        <TextBlock Style="{StaticResource SectionHeaderText}" Margin="0,0,0,4" Text="{Binding Title}" />
        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Group" Property="Margin" Value="0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Dwie kolumny grup, każda z własnym wyrównaniem kluczy; przy szerokości treści < 640 px prawa kolumna schodzi pod lewą
         i obie wyrównują klucze wspólnie (zakres SharedSizeGroup przechodzi na siatkę nadrzędną) -->
    <Style x:Key="LeftColumn" TargetType="ItemsControl">
      <Setter Property="Grid.IsSharedSizeScope" Value="True" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource WidthBelow}, ConverterParameter=640}" Value="True">
          <Setter Property="Grid.IsSharedSizeScope" Value="False" />
          <Setter Property="Grid.ColumnSpan" Value="3" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RightColumn" TargetType="ItemsControl">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Grid.IsSharedSizeScope" Value="True" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource WidthBelow}, ConverterParameter=640}" Value="True">
          <Setter Property="Grid.IsSharedSizeScope" Value="False" />
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.Row" Value="1" />
          <Setter Property="Grid.ColumnSpan" Value="3" />
          <Setter Property="Margin" Value="0,14,0,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <!-- Tytuł + Odśwież stan, grupy w dwóch kolumnach (przewijane), przyciski raportu przyklejone pod treścią (R16) -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource PageTitleText}" Text="{l:T 'Specyfikacja'}" />
      <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
              Content="{l:T 'Odśwież stan'}" Tag="Refresh" Command="{Binding RefreshCommand}" />
    </Grid>

    <!-- Przyciski poza przewijaniem: zawsze widoczne, także przy długiej specyfikacji na 1024×720 -->
    <!-- Po prawej stonowana linia autora (skraca się wielokropkiem przy wąskim oknie); przyciski zostają całe -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,16" LastChildFill="True">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Content="{l:T 'Zapisz raport'}" Tag="SaveReport" Command="{Binding SaveReportCommand}" />
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Kopiuj'}" Tag="Copy" Command="{Binding CopyCommand}" />
      </StackPanel>
      <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <views:BrandIcon Kind="GitHub" Size="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{x:Static core:ProductInfo.AuthorName}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Style="{StaticResource TextLinkButton}" Margin="10,0,0,0" Content="{x:Static core:ProductInfo.RepositoryUrlText}"
                AutomationProperties.Name="{l:T 'Otwórz github.com/ds99-01/DSOptimizer'}" Command="{Binding OpenRepositoryPageCommand}" />
      </Grid>
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,12,0">
        <Grid Grid.IsSharedSizeScope="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ItemsControl Style="{StaticResource LeftColumn}" Focusable="False"
                        ItemsSource="{Binding LeftGroups}" ItemTemplate="{StaticResource GroupTemplate}" />
          <ItemsControl Style="{StaticResource RightColumn}" Focusable="False"
                        ItemsSource="{Binding RightGroups}" ItemTemplate="{StaticResource GroupTemplate}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
