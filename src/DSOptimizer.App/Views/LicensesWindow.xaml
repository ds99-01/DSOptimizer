<ui:FluentWindow x:Class="DSOptimizer.App.Views.LicensesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:DSOptimizer.App.Gui"
                 Title="{l:T 'Licencje komponentów'}" Width="720" Height="640" MinWidth="420" MinHeight="300"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" TextOptions.TextFormattingMode="Display"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource BrandFont}"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
  <Window.Resources>
    <!-- Tekst licencji: tylko do odczytu, zaznaczanie i Ctrl+C, przewijanie; bez dekoracji pola WPF-UI (jak dziennik) -->
    <Style x:Key="NoticesTextBox" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsReadOnlyCaretVisible" Value="False" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Field" CornerRadius="3" BorderThickness="1" Padding="10,8,2,8"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{l:T 'Licencje komponentów'}" ShowMinimize="False" ShowMaximize="False" FontFamily="{StaticResource BrandFont}" />
    <TextBox x:Name="NoticesBox" Grid.Row="1" Margin="20,4,20,0" Style="{StaticResource NoticesTextBox}"
             AutomationProperties.Name="{l:T 'Licencje komponentów'}" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,16">
      <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Zamknij'}" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
