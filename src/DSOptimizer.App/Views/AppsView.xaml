<UserControl x:Class="DSOptimizer.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DSOptimizer.App.ViewModels"
             xmlns:views="clr-namespace:DSOptimizer.App.Views"
             xmlns:l="clr-namespace:DSOptimizer.App.Gui"
             xmlns:apps="clr-namespace:DSOptimizer.Core.Apps;assembly=DSOptimizer.Core"
             xmlns:gui="clr-namespace:DSOptimizer.Core.Gui;assembly=DSOptimizer.Core">
  <!-- Strona „Aplikacje” (render Tasku 1, wariant B wybrany przez autora 2026-10-21): nagłówek z „Odśwież listę”, wyszukiwarka
       strony, przełącznik grup z licznikami nad listą, lista jak na stronach kategorii (pole wyboru | nazwa i wydawca | rodzaj),
       panel szczegółów o szerokości jak na stronie kategorii i własny pasek serii „Usuń (N)” (obramowanie „L” jak pasek kategorii).
       Bez kart, ramek i teł do wyróżniania. Teksty z AppsPageText. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Przełącznik grup: wybrana półgruba z krótką kreską akcentu pod spodem, pozostałe drugorzędne; licznik obok nazwy -->
    <Style x:Key="GroupSwitchItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocusVisual}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,0,24,0" Background="Transparent">
              <StackPanel Orientation="Horizontal" Margin="0,2,0,9">
                <TextBlock x:Name="GroupName" FontSize="13.5" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Name}" />
                <TextBlock FontSize="12.5" Margin="7,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Count}" />
              </StackPanel>
              <Rectangle x:Name="Accent" Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource TextFillColorPrimaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="GroupName" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="GroupName" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Wiersz aplikacji: pole wyboru (usuwalna) albo kłódka (chroniona) albo nic (inne konto, niepewny użytkownik, brak polecenia) |
         nazwa, wydawca, ostrzeżenie z listy albo powód blokady | rodzaj. Krawędź w kolorze akcentu = zaznaczona do usunięcia (jak seria tweaków). -->
    <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type vm:AppRowViewModel}">
      <Border x:Name="SeriesEdge" BorderThickness="3,0,0,0" BorderBrush="Transparent">
        <Grid Margin="9,10,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="76" />
          </Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource BrandCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}"
                    Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}" />
          <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Left"
                Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ToolTip>
              <ToolTip Style="{StaticResource BrandToolTip}" Content="{x:Static apps:AppsPageText.ProtectedTooltip}" />
            </Grid.ToolTip>
            <views:BrandIcon Kind="{x:Static gui:GuiIcons.Lock}" Size="16" Margin="1,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource ItemTitleText}" Text="{Binding Name}" ToolTip="{Binding Name}" />
            <TextBlock Style="{StaticResource SubText}" Text="{Binding PublisherText}" ToolTip="{Binding PublisherText}" />
            <Grid Margin="0,4,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <views:BrandIcon Kind="Warning" Size="14" Margin="0,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
              <TextBlock Grid.Column="1" Style="{StaticResource SubText}" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Warning}" />
            </Grid>
            <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" Text="{Binding RowNote}"
                       Visibility="{Binding HasRowNote, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Style="{StaticResource SubText}" Margin="12,3,0,0" VerticalAlignment="Top" Text="{Binding KindText}" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="SeriesEdge" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Wiersz „nazwa – wartość” panelu szczegółów (zawijany, bez wielokropka) -->
    <Style x:Key="DetailValueWrap" TargetType="TextBlock" BasedOn="{StaticResource DetailValueText}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- Treść (lista i szczegóły) | pasek serii (8 + 56, jak na stronach kategorii) -->
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="ContentGrid" SizeChanged="OnContentSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="DetailColumn" Width="246" />
      </Grid.ColumnDefinitions>

      <!-- Tab: szukaj → „Odśwież listę” → grupy → lista (TabIndex lokalnie) -->
      <DockPanel Margin="0,0,20,0" KeyboardNavigation.TabNavigation="Local">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding Name}" />
            <TextBlock Style="{StaticResource SubText}" Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" />
          </StackPanel>
          <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                  Content="{x:Static apps:AppsPageText.RefreshButton}" Tag="Refresh" Command="{Binding RefreshCommand}" KeyboardNavigation.TabIndex="2" />
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" Tag="{Binding SearchPlaceholder}" KeyboardNavigation.TabIndex="1"
                   AutomationProperties.Name="{l:T 'Szukaj aplikacji'}" AutomationProperties.HelpText="{Binding SearchPlaceholder}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,12,0">
          <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}" SelectedValuePath="Value" SelectedValue="{Binding SelectedGroup}"
                   ItemContainerStyle="{StaticResource GroupSwitchItem}" Background="Transparent" BorderThickness="0" Padding="0"
                   AutomationProperties.Name="{l:T 'Grupy aplikacji'}" KeyboardNavigation.TabIndex="3"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.Template>
              <ControlTemplate TargetType="ListBox">
                <ItemsPresenter />
              </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </StackPanel>

        <Grid>
          <TextBlock VerticalAlignment="Top" Margin="0,10,0,0" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{Binding EmptyText}" />
          <ListBox x:Name="AppList" Style="{StaticResource ItemListBox}" ItemTemplate="{StaticResource AppRowTemplate}" KeyboardNavigation.TabIndex="4"
                   ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutomationProperties.Name="{l:T 'Aplikacje'}"
                   MouseDoubleClick="OnAppListDoubleClick" PreviewKeyDown="OnAppListKeyDown" />
        </Grid>
      </DockPanel>

      <!-- Szczegóły aplikacji: nazwa, opis reguły, ostrzeżenie, linia serii, tabela, szczegóły techniczne (tylko do odczytu) -->
      <DockPanel Grid.Column="1" DataContext="{Binding SelectedRow}">
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>
        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="True" FocusVisualStyle="{StaticResource BrandFocusVisual}" AutomationProperties.Name="{Binding Name}">
          <StackPanel Margin="0,0,12,12">
            <TextBlock Style="{StaticResource DetailTitleText}" Text="{Binding Name}" />
            <TextBlock Style="{StaticResource SummaryText}" Margin="0,10,0,0" Text="{Binding Summary}"
                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
            <Grid Margin="0,10,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <views:BrandIcon Kind="Warning" Size="16" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Margin="0,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
              <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding Warning}" />
            </Grid>
            <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding SelectionLineText}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectionLineText}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource DetailKeyText}" Text="{l:T 'Grupa'}" />
              <TextBlock Grid.Column="1" Style="{StaticResource DetailValueWrap}" Text="{Binding GroupText}" />
              <TextBlock Grid.Row="1" Style="{StaticResource DetailKeyText}" Text="{l:T 'Rodzaj'}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValueWrap}" Text="{Binding KindLongText}" />
              <TextBlock Grid.Row="2" Style="{StaticResource DetailKeyText}" Text="{l:T 'Wydawca'}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValueWrap}" Text="{Binding PublisherDetail}" />
              <TextBlock Grid.Row="3" Style="{StaticResource DetailKeyText}" Text="{l:T 'Wersja'}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValueWrap}" Text="{Binding VersionText}" />
              <TextBlock Grid.Row="4" Style="{StaticResource DetailKeyText}" Text="{l:T 'Konto'}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValueWrap}" Text="{Binding AccountText}" />
              <TextBlock Grid.Row="5" Style="{StaticResource DetailKeyText}" Text="{l:T 'Usuwanie'}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValueWrap}" Text="{Binding RemovalText}" />
              <TextBlock Grid.Row="6" Style="{StaticResource DetailKeyText}" Text="{l:T 'Cofanie'}" />
              <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValueWrap}" Text="{Binding UndoText}" />
            </Grid>
            <TextBlock Style="{StaticResource SectionHeaderText}" Margin="0,16,0,4" Text="{x:Static apps:AppsPageText.TechnicalHeader}" />
            <TextBlock Style="{StaticResource BodyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TechnicalText}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- Pasek serii usuwania: obramowanie „L” w kolorze marki (lewa 3 px + dolna 1 px) jak na stronach kategorii; bez „Cofnij” -->
    <Border Grid.Row="1" Height="56" Margin="0,8,0,0" Padding="14,0,12,0"
            BorderThickness="3,0,0,1" BorderBrush="{DynamicResource BrandAccentBrush}"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding SelectionBarTitle}"
                     ToolTip="{Binding SelectionBarTitle}" />
          <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding SelectionBarDetails}" ToolTip="{Binding SelectionBarDetails}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SubText}">
                <Style.Triggers>
                  <Trigger Property="Text" Value="">
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="1" Margin="12,0,12,0" Style="{StaticResource TextLinkButton}" Content="{l:T 'Odznacz wszystko'}"
                Command="{Binding ClearSelectionCommand}" />
        <Button x:Name="RemoveButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
