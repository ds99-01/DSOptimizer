<ui:FluentWindow x:Class="DSOptimizer.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:DSOptimizer.App.ViewModels"
                 xmlns:views="clr-namespace:DSOptimizer.App.Views"
                 xmlns:gui="clr-namespace:DSOptimizer.Core.Gui;assembly=DSOptimizer.Core"
                 Title="DSOptimizer" MinWidth="800" MinHeight="520"
                 WindowStartupLocation="Manual" TextOptions.TextFormattingMode="Display"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource BrandFont}"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Closing="OnClosing">
  <!-- Ctrl+F (ApplicationCommands.Find): fokus i zaznaczenie pola wyszukiwania -->
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
  </Window.CommandBindings>
  <!-- F5: odświeżenie otwartej strony (kategoria, Specyfikacja, Przygotowanie, Aplikacje, Historia; w trakcie operacji nic) -->
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCurrentPageCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Specyfikacja w lewej kolumnie: sama nazwa, bez licznika; w zwiniętym menu sama ikona wyśrodkowana w 56 px (18 + 20 + 18) z nazwą w podpowiedzi -->
    <DataTemplate DataType="{x:Type vm:SpecificationViewModel}">
      <Grid x:Name="Root" Background="Transparent" ToolTipService.IsEnabled="False">
        <Grid.ToolTip>
          <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding Name}" />
        </Grid.ToolTip>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:BrandIcon x:Name="Icon" Margin="16,0,12,0" Size="20" Kind="{x:Static gui:GuiIcons.Specification}" Foreground="{StaticResource SideForegroundBrush}"
                         VerticalAlignment="Center" />
        <TextBlock x:Name="PageName" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Normal"
                   Foreground="{StaticResource SideForegroundBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="PageName" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="Icon" Property="Margin" Value="18,0,18,0" />
          <Setter TargetName="PageName" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Root" Property="ToolTipService.IsEnabled" Value="True" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Przygotowanie (tuż pod Specyfikacją): jak Specyfikacja, ikona I1 (lista z ptaszkami), bez licznika -->
    <DataTemplate DataType="{x:Type vm:PrepViewModel}">
      <Grid x:Name="Root" Background="Transparent" ToolTipService.IsEnabled="False">
        <Grid.ToolTip>
          <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding Name}" />
        </Grid.ToolTip>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:BrandIcon x:Name="Icon" Margin="16,0,12,0" Size="20" Kind="{Binding IconKind}" Foreground="{StaticResource SideForegroundBrush}"
                         VerticalAlignment="Center" />
        <TextBlock x:Name="PageName" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Normal"
                   Foreground="{StaticResource SideForegroundBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="PageName" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="Icon" Property="Margin" Value="18,0,18,0" />
          <Setter TargetName="PageName" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Root" Property="ToolTipService.IsEnabled" Value="True" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Ustawienia przypięte na dole lewej kolumny: ikona i nazwa, bez licznika; w zwiniętym menu jak Specyfikacja -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <Grid x:Name="Root" Background="Transparent" ToolTipService.IsEnabled="False">
        <Grid.ToolTip>
          <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding Name}" />
        </Grid.ToolTip>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:BrandIcon x:Name="Icon" Margin="16,0,12,0" Size="20" Kind="{x:Static gui:GuiIcons.Settings}" Foreground="{StaticResource SideForegroundBrush}"
                         VerticalAlignment="Center" />
        <TextBlock x:Name="PageName" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Normal"
                   Foreground="{StaticResource SideForegroundBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="PageName" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="Icon" Property="Margin" Value="18,0,18,0" />
          <Setter TargetName="PageName" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Root" Property="ToolTipService.IsEnabled" Value="True" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Kategoria w lewej kolumnie: ikona 20 px, nazwa (ucięta z podpowiedzią) i licznik („zastosowane/tweaki” albo liczba pozycji);
         w zwiniętym menu sama ikona wyśrodkowana, „Nazwa – licznik” w podpowiedzi -->
    <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
      <Grid x:Name="Root" Background="Transparent" ToolTipService.IsEnabled="False">
        <Grid.ToolTip>
          <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding NavToolTip}" />
        </Grid.ToolTip>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <views:BrandIcon x:Name="Icon" Margin="16,0,12,0" Size="20" Kind="{Binding IconKind}" Foreground="{StaticResource SideForegroundBrush}"
                         VerticalAlignment="Center" />
        <TextBlock x:Name="CategoryName" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Normal"
                   Foreground="{StaticResource SideForegroundBrush}" Text="{Binding Name}" ToolTip="{Binding Name}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Counter" Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Normal"
                   Foreground="{StaticResource SideCountBrush}" Text="{Binding CounterText}"
                   AutomationProperties.Name="{Binding CounterDescription}">
          <TextBlock.ToolTip>
            <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding CounterDescription}" />
          </TextBlock.ToolTip>
        </TextBlock>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="CategoryName" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="Icon" Property="Margin" Value="18,0,18,0" />
          <Setter TargetName="CategoryName" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Counter" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Root" Property="ToolTipService.IsEnabled" Value="True" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Aplikacje (między kategoriami a historią): jak kategoria, ikona K1, licznik = liczba aplikacji (pusty przed pierwszym odczytem) -->
    <DataTemplate DataType="{x:Type vm:AppsViewModel}">
      <Grid x:Name="Root" Background="Transparent" ToolTipService.IsEnabled="False">
        <Grid.ToolTip>
          <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding NavToolTip}" />
        </Grid.ToolTip>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <views:BrandIcon x:Name="Icon" Margin="16,0,12,0" Size="20" Kind="{Binding IconKind}" Foreground="{StaticResource SideForegroundBrush}"
                         VerticalAlignment="Center" />
        <TextBlock x:Name="PageName" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Normal"
                   Foreground="{StaticResource SideForegroundBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Counter" Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Normal"
                   Foreground="{StaticResource SideCountBrush}" Text="{Binding CounterText}"
                   AutomationProperties.Name="{Binding CounterDescription}">
          <TextBlock.ToolTip>
            <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding CounterDescription}" />
          </TextBlock.ToolTip>
        </TextBlock>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="PageName" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="Icon" Property="Margin" Value="18,0,18,0" />
          <Setter TargetName="PageName" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Counter" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Root" Property="ToolTipService.IsEnabled" Value="True" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Instalacja (tuż pod Aplikacjami): jak kategoria, ikona I2, licznik = pozycje listy (pusty przed pierwszym odczytem) -->
    <DataTemplate DataType="{x:Type vm:InstallViewModel}">
      <Grid x:Name="Root" Background="Transparent" ToolTipService.IsEnabled="False">
        <Grid.ToolTip>
          <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding NavToolTip}" />
        </Grid.ToolTip>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <views:BrandIcon x:Name="Icon" Margin="16,0,12,0" Size="20" Kind="{Binding IconKind}" Foreground="{StaticResource SideForegroundBrush}"
                         VerticalAlignment="Center" />
        <TextBlock x:Name="PageName" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Normal"
                   Foreground="{StaticResource SideForegroundBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Counter" Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Normal"
                   Foreground="{StaticResource SideCountBrush}" Text="{Binding CounterText}"
                   AutomationProperties.Name="{Binding CounterDescription}">
          <TextBlock.ToolTip>
            <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding CounterDescription}" />
          </TextBlock.ToolTip>
        </TextBlock>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="PageName" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="Icon" Property="Margin" Value="18,0,18,0" />
          <Setter TargetName="PageName" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Counter" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Root" Property="ToolTipService.IsEnabled" Value="True" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Historia zmian (ostatnia pozycja górnej listy): jak kategoria, licznik = aktywne zmiany (także „0”) -->
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
      <Grid x:Name="Root" Background="Transparent" ToolTipService.IsEnabled="False">
        <Grid.ToolTip>
          <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding NavToolTip}" />
        </Grid.ToolTip>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <views:BrandIcon x:Name="Icon" Margin="16,0,12,0" Size="20" Kind="{Binding IconKind}" Foreground="{StaticResource SideForegroundBrush}"
                         VerticalAlignment="Center" />
        <TextBlock x:Name="PageName" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Normal"
                   Foreground="{StaticResource SideForegroundBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Counter" Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Normal"
                   Foreground="{StaticResource SideCountBrush}" Text="{Binding CounterText}"
                   AutomationProperties.Name="{Binding CounterDescription}">
          <TextBlock.ToolTip>
            <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding CounterDescription}" />
          </TextBlock.ToolTip>
        </TextBlock>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="PageName" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="Icon" Property="Margin" Value="18,0,18,0" />
          <Setter TargetName="PageName" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Counter" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Root" Property="ToolTipService.IsEnabled" Value="True" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Wiersz pozycji: pole wyboru (tylko tweak) | „uruchom” ▶ (tylko akcja i panel; u tweaka kolumna znika) | nazwa i podpis (opis w podpowiedzi;
         przy stanie Zastosowane znak ✓ przed tekstem stanu – ten sam co „✓ Zainstalowana” w Instalacji) | wskaźnik ryzyka (S4, 2026-10-26) -->
    <DataTemplate x:Key="ItemRowTemplate" DataType="{x:Type vm:ItemViewModel}">
      <Border x:Name="SeriesEdge" BorderThickness="3,0,0,0" BorderBrush="Transparent">
      <Grid Margin="9,10,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="22" />
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="SelectBox" Style="{StaticResource BrandCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding SelectHint}"
                  ToolTipService.InitialShowDelay="600"
                  Visibility="{Binding IsTweak, Converter={StaticResource BoolToVisibility}}">
          <CheckBox.ToolTip>
            <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding SelectHint}" />
          </CheckBox.ToolTip>
        </CheckBox>
        <!-- ▶ tylko u akcji i panelu (wyzwalacz IsExecutable); u tweaka zwinięty, więc kolumna ma 0 px i tytuły tweaków stoją równo przy polu wyboru -->
        <ContentPresenter x:Name="Marker" Grid.Column="1" Width="22" VerticalAlignment="Center" Visibility="Collapsed" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource ItemTitleText}" Text="{Binding Title}">
            <TextBlock.ToolTip>
              <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding Summary}" />
            </TextBlock.ToolTip>
          </TextBlock>
          <DockPanel>
            <Path x:Name="AppliedMark" DockPanel.Dock="Left" Data="M1.5,6 L4.5,9 L10.5,2.5" Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="11"
                  Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock Style="{StaticResource SubText}" Text="{Binding RowSubtitle}" ToolTip="{Binding RowSubtitle}" />
          </DockPanel>
        </StackPanel>
        <!-- Żarówka = pozycja sugerowana (wariant C, wybór Dawida 2026-10-21); znika na pozycji nieobsługiwanej (nie jest wtedy sugerowana) -->
        <Grid Grid.Column="3" Margin="12,0,12,0" VerticalAlignment="Center" Background="Transparent"
              ToolTip="{x:Static gui:GuiText.SuggestedTooltip}">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuggested}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NotSupported">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.Resources>
            <Style TargetType="ToolTip" BasedOn="{StaticResource BrandToolTip}" />
          </Grid.Resources>
          <views:BrandIcon Kind="Suggested" Size="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
        <!-- Wskaźnik ryzyka z podpowiedzią „Ryzyko: …” (przezroczyste tło = cel najechania także między kreskami) -->
        <Grid Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Background="Transparent"
              AutomationProperties.Name="{Binding RiskToolTip}">
          <Grid.ToolTip>
            <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding RiskToolTip}" />
          </Grid.ToolTip>
          <ContentPresenter Content="{Binding Risk}" ContentTemplate="{StaticResource RiskMeterTemplate}" />
        </Grid>
      </Grid>
      </Border>
      <DataTemplate.Triggers>
        <!-- Krawędź w kolorze akcentu = pozycja w serii (osobno od szarego tła „pokazany w panelu”) -->
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="SeriesEdge" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Applied">
          <Setter TargetName="AppliedMark" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsExecutable}" Value="True">
          <Setter TargetName="Marker" Property="ContentTemplate" Value="{StaticResource RunMarkerTemplate}" />
          <Setter TargetName="Marker" Property="Content" Value="" />
          <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Nagłówek grupy („Ustawienia” / „Akcje” albo kategoria w wynikach wyszukiwania) + cienka linia.
         Odstęp 16 nad każdym nagłówkiem poza pierwszą widoczną grupą (GroupStyle.AlternationCount numeruje grupy od 0). -->
    <DataTemplate x:Key="SectionHeaderTemplate">
      <StackPanel>
        <TextBlock x:Name="Header" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,4" Text="{Binding Name}" />
        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=GroupItem}}" Value="0">
          <Setter TargetName="Header" Property="Margin" Value="0,0,0,4" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Grupa listy bez domyślnego wcięcia 5 px pozycji (szablon GroupItem WPF): wiersze, ich krawędź w kolorze akcentu i szare tło
         zaczynają się równo z nagłówkiem sekcji i jego linią (render 02) -->
    <Style x:Key="FlatGroupItem" TargetType="GroupItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupItem">
            <StackPanel>
              <ContentPresenter />
              <ItemsPresenter />
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ostrzeżenie w szczegółach: trójkąt w kolorze ostrzeżenia + tekst -->
    <DataTemplate x:Key="WarningTemplate">
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:BrandIcon Kind="Warning" Size="16" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                         Margin="0,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Grid.Column="1" Style="{StaticResource DetailBodyText}" Text="{Binding}" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{DynamicResource ApplicationBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Pasek marki | baner restartu (zwinięty, gdy nic nie czeka na restart) | treść (z paskiem akcji na dole) | uchwyt wysokości dziennika | dziennik.
         Wysokość dziennika ustawia okno po rozmiarze startowym (GuiLayout.InitialLogHeight), górną granicę przy każdej zmianie rozmiaru. -->
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="5" />
      <RowDefinition x:Name="LogRow" Height="146" MinHeight="146" />
    </Grid.RowDefinitions>
    <!-- Menu 304 (GuiLayout.NavFullWidth) = najmniejsza wielokrotność 4, przy której „Bezpieczeństwo i szyfrowanie” pogrubione
         + licznik dwucyfrowy mieszczą się obok ikony 20 px z zapasem ≥ 5 px: Hanken Grotesk SemiBold 14 px 193 + licznik „88/88” 33
         + ikona z odstępami 48 + odstęp za nazwą 8 + za licznikiem 16 = 298 (pomiar 2026-10-21; dawne 187 było na czcionce zastępczej).
         Poniżej 1100 px szerokości okna menu zwija się do ikon (56 px): szerokość i IsNavCompact ustawia okno (GuiLayout.NavWidth). -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavColumn" Width="304" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Pasek marki: znak DŚO 28×28, nazwa;
         dalej komputer (jedyny element, który się skraca wielokropkiem); po prawej Administrator i przyciski okna.
         Lewa część ma szerokość Auto i zostaje cała także przy minimalnej szerokości okna. Przeciąganie = obszar podpisu WindowChrome.
         Tekst komputera bez IsHitTestVisibleInChrome i bez podpowiedzi: zajmuje środek paska i blokował przeciąganie okna (2026-10-26);
         pełny opis komputera jest na stronie „Specyfikacja”. -->
    <Grid x:Name="BrandBar" Grid.ColumnSpan="2" Background="{StaticResource HeadBackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <Image Source="{StaticResource BrandMarkImage}" Width="28" Height="28" />
        <TextBlock Text="DSOptimizer" FontWeight="Bold" FontSize="16" Foreground="{StaticResource HeadForegroundBrush}"
                   Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding MachineText}" FontSize="12.5" FontWeight="Normal"
                 Foreground="{StaticResource HeadForegroundBrush}" Opacity=".8" Margin="22,1,14,0" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="Administrator" FontSize="12" FontWeight="Normal" Foreground="{StaticResource HeadForegroundBrush}"
                   Opacity=".8" VerticalAlignment="Center" Margin="14,0,14,0" />
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                AutomationProperties.Name="Minimalizuj" ToolTip="Minimalizuj" Click="OnMinimizeClick" />
        <Button x:Name="MaximizeButton" Click="OnMaximizeClick">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
              <Setter Property="Content" Value="&#xE922;" />
              <Setter Property="AutomationProperties.Name" Value="Maksymalizuj" />
              <Setter Property="ToolTip" Value="Maksymalizuj" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                  <Setter Property="Content" Value="&#xE923;" />
                  <Setter Property="AutomationProperties.Name" Value="Przywróć" />
                  <Setter Property="ToolTip" Value="Przywróć" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                AutomationProperties.Name="Zamknij" ToolTip="Zamknij" Click="OnCloseClick" />
      </StackPanel>
    </Grid>

    <!-- Baner „Wymagany restart” (makieta 4-baner): pod paskiem marki na całą szerokość, liczony z journala i czasu startu systemu,
         więc zostaje także po ponownym otwarciu programu – do restartu. Tekst zawija się w wąskim oknie, przyciski zostają po prawej.
         „Pokaż które” otwiera stronę „Historia zmian” z filtrem „Czekające na restart”.
         „Uruchom ponownie” zawsze najpierw pyta (ConfirmRestartAsync), w trakcie operacji nieaktywny. -->
    <Border x:Name="RebootBanner" Grid.Row="1" Grid.ColumnSpan="2" Padding="16,8" BorderThickness="0,0,0,1"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            Visibility="{Binding IsRebootBannerVisible, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <views:BrandIcon Kind="Warning" Size="16" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"
                         Margin="0,0,10,0" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Content="Pokaż które" Style="{StaticResource TextLinkButton}" Margin="0,0,14,0" Command="{Binding ShowPendingCommand}" />
          <Button Content="Uruchom ponownie" Style="{StaticResource SecondaryButton}" Command="{Binding RestartCommand}" />
        </StackPanel>
        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center">
          <Run FontWeight="SemiBold" Text="{x:Static gui:GuiText.RebootTitle}" />
          <Run Text="{Binding RebootBannerText, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
    </Border>
    <!-- Lewa kolumna: Specyfikacja, potem kategorie w kolejności GuiSession.Categories z licznikiem pozycji (szablony wg typu);
         na dole, za linią, „Ustawienia” (druga lista z jedną pozycją). Każda lista wiąże własne zaznaczenie (SelectedNavItem,
         SelectedPinnedItem): strona z drugiej listy = null w tej liście, więc podświetlona jest jedna pozycja w obu listach,
         a klik w dowolną pozycję zmienia stronę (null z ListBoxa SelectedPage ignoruje).
         Siatka zamiast DockPanel: górna lista jest w drzewie przed „Ustawieniami”, więc Tab idzie z góry na dół. -->
    <Grid Grid.Row="2" Grid.RowSpan="3" Background="{StaticResource SideBackgroundBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ListBox x:Name="NavList" Margin="0,10,0,0" Style="{StaticResource NavListBox}"
               ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
               AutomationProperties.Name="Menu" PreviewMouseLeftButtonUp="OnNavClick" />
      <StackPanel Grid.Row="1" Margin="0,6,0,6">
        <!-- Linia wcięta po 16 px z obu stron, jak w renderze 09; w zwiniętym menu po 12 px -->
        <Border Height="1" Background="{StaticResource SideDividerBrush}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Margin" Value="16,0,16,6" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                  <Setter Property="Margin" Value="12,0,12,6" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <ListBox x:Name="SettingsNavList" Style="{StaticResource NavListBox}"
                 ItemsSource="{Binding PinnedNavItems}" SelectedItem="{Binding SelectedPinnedItem, Mode=TwoWay}"
                 AutomationProperties.Name="Ustawienia" />
      </StackPanel>
    </Grid>

    <!-- Treść strony Specyfikacja -->
    <Grid Grid.Row="2" Grid.Column="1" Margin="22,16,16,0"
          Visibility="{Binding IsSpecificationSelected, Converter={StaticResource BoolToVisibility}}">
      <views:SpecificationView DataContext="{Binding Specification}" />
    </Grid>

    <!-- Treść strony Przygotowanie: kroki po instalacji Windows (jedna kolumna, przewijana) -->
    <Grid Grid.Row="2" Grid.Column="1" Margin="22,16,16,0"
          Visibility="{Binding IsPrepSelected, Converter={StaticResource BoolToVisibility}}">
      <views:PrepView DataContext="{Binding Prep}" />
    </Grid>

    <!-- Treść strony Ustawienia: formularz i „O programie” (kolumna o szerokości panelu szczegółów) -->
    <Grid Grid.Row="2" Grid.Column="1" Margin="22,16,16,0"
          Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVisibility}}">
      <views:SettingsView DataContext="{Binding Settings}" />
    </Grid>

    <!-- Treść strony Historia zmian: lista wpisów i szczegóły wpisu (bez paska akcji serii) -->
    <Grid Grid.Row="2" Grid.Column="1" Margin="22,16,16,0"
          Visibility="{Binding IsHistorySelected, Converter={StaticResource BoolToVisibility}}">
      <views:HistoryView DataContext="{Binding History}" />
    </Grid>

    <!-- Treść strony Aplikacje: lista z przełącznikiem grup, szczegóły i własny pasek „Usuń (N)” (dolny margines 8 jak pasek kategorii) -->
    <Grid Grid.Row="2" Grid.Column="1" Margin="22,16,16,8"
          Visibility="{Binding IsAppsSelected, Converter={StaticResource BoolToVisibility}}">
      <views:AppsView x:Name="AppsPage" DataContext="{Binding Apps}" />
    </Grid>

    <!-- Treść strony Instalacja: kategorie z licznikami, wyszukiwanie w winget, wiersze i własny pasek „Zainstaluj (N)” (jak Aplikacje) -->
    <Grid Grid.Row="2" Grid.Column="1" Margin="22,16,16,8"
          Visibility="{Binding IsInstallSelected, Converter={StaticResource BoolToVisibility}}">
      <views:InstallView x:Name="InstallPage" DataContext="{Binding Install}" />
    </Grid>

    <!-- Treść kategorii albo wyników wyszukiwania: środek (lista) i prawa kolumna (szczegóły bieżącej pozycji).
         Dolny margines 72 = odstęp nad paskiem (8) + pasek akcji (56) + odstęp pod nim (8); pasek leży w tym samym wierszu, przy dolnej krawędzi. -->
    <Grid x:Name="ContentGrid" Grid.Row="2" Grid.Column="1" Margin="22,16,16,72" SizeChanged="OnContentSizeChanged"
          Visibility="{Binding IsCategorySelected, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="DetailColumn" Width="246" />
      </Grid.ColumnDefinitions>

      <!-- Tab: szukaj → filtr ryzyka → „Odśwież stan” → lista (TabIndex lokalnie w tym panelu; w drzewie przycisk jest pierwszy) -->
      <DockPanel Margin="0,0,20,0" KeyboardNavigation.TabNavigation="Local">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding PageTitle}" />
            <TextBlock Style="{StaticResource SubText}" Text="{Binding PageSubtitle}" ToolTip="{Binding PageSubtitle}" />
          </StackPanel>
          <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                  Content="Odśwież stan" Tag="Refresh" Command="{Binding RefreshCommand}" KeyboardNavigation.TabIndex="3" />
        </Grid>

        <!-- Wyszukiwarka (wszystkie kategorie, Esc czyści) i filtr ryzyka -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" AutomationProperties.Name="Szukaj" KeyboardNavigation.TabIndex="1"
                   AutomationProperties.HelpText="{x:Static gui:GuiText.SearchPlaceholder}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Grid.Column="1" Style="{StaticResource SubText}" Margin="14,0,8,0" VerticalAlignment="Center" Text="Ryzyko" />
          <ComboBox Grid.Column="2" Style="{StaticResource BrandComboBox}" AutomationProperties.Name="Ryzyko" KeyboardNavigation.TabIndex="2"
                    ItemsSource="{Binding RiskFilterOptions}" SelectedValuePath="Value" SelectedValue="{Binding RiskFilter}" />
        </Grid>

        <!-- Lista (kategoria z sekcjami albo wyniki z nagłówkami kategorii), pod nią „Ukryte przez filtr” -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock VerticalAlignment="Top" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{Binding EmptyText}" />
          <ListBox x:Name="ItemList" IsSynchronizedWithCurrentItem="True" ItemTemplate="{StaticResource ItemRowTemplate}"
                   AutomationProperties.Name="Pozycje" PreviewMouseLeftButtonDown="OnItemListMouseDown" PreviewMouseLeftButtonUp="OnItemListMouseUp" PreviewKeyDown="OnItemListKeyDown">
            <ListBox.Style>
              <Style TargetType="ListBox" BasedOn="{StaticResource ItemListBox}">
                <Setter Property="ItemsSource" Value="{Binding SelectedCategory.ItemsView}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSearching}" Value="True">
                    <Setter Property="ItemsSource" Value="{Binding SearchResultsView}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.Style>
            <ListBox.GroupStyle>
              <GroupStyle HeaderTemplate="{StaticResource SectionHeaderTemplate}" ContainerStyle="{StaticResource FlatGroupItem}" AlternationCount="1000" />
            </ListBox.GroupStyle>
          </ListBox>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8"
                      Visibility="{Binding HasFilterNote, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource SubText}" VerticalAlignment="Center" Text="{Binding FilterNoteText}" />
            <Button Style="{StaticResource TextLinkButton}" Margin="12,0,0,0" Content="Pokaż wszystkie" Command="{Binding ShowAllCommand}" />
          </StackPanel>
        </Grid>
      </DockPanel>

      <!-- Prawa kolumna: szczegóły bieżącej pozycji; treść przewijana, przyciski przyklejone na dole. Brak pozycji = zwinięta.
           Enter na wierszu listy przenosi tu fokus („Uruchom”); autopowtórzenie Entera nie wciska przycisku (PreviewKeyDown).
           Tab: treść (przewijana strzałkami i PgUp/PgDn) → „Szczegóły techniczne” → „Uruchom” (TabIndex lokalnie; w drzewie
           przycisk jest pierwszy; treść to osobny zakres Local, żeby nagłówek rozwijania był przed przyciskiem). -->
      <DockPanel x:Name="DetailPanel" Grid.Column="1" DataContext="{Binding DetailItem}" KeyboardNavigation.TabNavigation="Local"
                 PreviewKeyDown="OnDetailPanelPreviewKeyDown" DataContextChanged="OnDetailPanelDataContextChanged">
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>
        <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding IsExecutable, Converter={StaticResource BoolToVisibility}}">
          <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,14">
            <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="Uruchom" Command="{Binding ExecuteCommand}"
                    KeyboardNavigation.TabIndex="2" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.TabNavigation="Local"
                      FocusVisualStyle="{StaticResource BrandFocusVisual}" AutomationProperties.Name="{Binding Title}">
          <!-- RequestBringIntoView na treści, nie na ScrollViewerze: jego obsługa klasy działa przed obsługą instancji i oznacza zdarzenie jako obsłużone -->
          <StackPanel Margin="0,0,12,12" Grid.IsSharedSizeScope="True" RequestBringIntoView="OnDetailContentRequestBringIntoView">
            <TextBlock Style="{StaticResource DetailTitleText}" Text="{Binding Title}" />
            <!-- Co zyskasz (tylko tweak i akcja): płaskie neutralne tło (jak bloki Ustawień Windows 11), bez obrysu i paska – wariant B, wybór Dawida.
                 Panel nie ma benefitu: opis bez nagłówka. -->
            <Border Margin="0,14,0,0" Padding="14,11,14,13" CornerRadius="4"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    Visibility="{Binding HasBenefit, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderText}" Margin="0,0,0,4" Text="Co zyskasz" />
                <TextBlock Style="{StaticResource DetailSummaryText}" Text="{Binding Benefit}" />
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SectionHeaderText}" Margin="0,16,0,4" Text="Co zmienia"
                       Visibility="{Binding HasBenefit, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Summary}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailSummaryText}">
                  <Setter Property="Margin" Value="0,10,0,0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasBenefit}" Value="True">
                      <Setter Property="Margin" Value="0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource WarningTemplate}" Focusable="False" />
            <!-- Edycje (tylko pozycje z polem editions): pod „Co zmienia”, przed linią serii (render edycja-home) -->
            <TextBlock Style="{StaticResource DetailBodyText}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding EditionsText}"
                       Visibility="{Binding HasEditions, Converter={StaticResource BoolToVisibility}}" />
            <!-- Seria (tylko tweak): czy pozycja jest zaznaczona do Zastosuj/Cofnij na pasku nad dziennikiem -->
            <TextBlock Style="{StaticResource DetailBodyText}" Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding SeriesLineText}"
                       Visibility="{Binding IsTweak, Converter={StaticResource BoolToVisibility}}" />
            <!-- Od razu widoczne tylko Stan, Ryzyko i Restart; Cofanie, Identyfikator i opis techniczny w „Szczegółach technicznych”.
                 Kolumna etykiet wspólna dla obu siatek (SharedSizeGroup), żeby wartości po rozwinięciu stały w jednej linii. -->
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DetailKey" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource DetailKeyText}" Text="Stan" />
              <TextBlock Grid.Column="1" Style="{StaticResource DetailValueText}" FontWeight="SemiBold"
                         TextWrapping="Wrap" TextTrimming="None" Text="{Binding DetailStateText}" ToolTip="{Binding DetailStateText}" />
              <TextBlock Grid.Row="1" Style="{StaticResource DetailKeyText}" Text="Ryzyko" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource DetailValueText}" VerticalAlignment="Center" Text="{Binding DetailRiskText}" />
                <Grid Margin="8,1,0,0" VerticalAlignment="Center" Background="Transparent" AutomationProperties.Name="{Binding RiskToolTip}">
                  <Grid.ToolTip>
                    <ToolTip Style="{StaticResource BrandToolTip}" Content="{Binding RiskToolTip}" />
                  </Grid.ToolTip>
                  <ContentPresenter Content="{Binding Risk}" ContentTemplate="{StaticResource RiskMeterTemplate}" />
                </Grid>
              </StackPanel>
              <TextBlock Grid.Row="2" Style="{StaticResource DetailKeyText}" Text="Restart po zmianie" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValueText}" Text="{Binding DetailRebootText}" />
            </Grid>
            <!-- Rozwinięcie zapamiętane w MainViewModel do zamknięcia programu (DataContext panelu = pozycja, więc wiązanie do okna) -->
            <Expander Style="{StaticResource TechnicalDetailsExpander}" Margin="0,12,0,0" Header="Szczegóły techniczne"
                      AutomationProperties.Name="Szczegóły techniczne" Expanded="OnTechnicalDetailsExpanded"
                      IsExpanded="{Binding DataContext.TechnicalDetailsExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DetailKey" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource DetailKeyText}" Text="Cofanie" />
                  <TextBlock Grid.Column="1" Style="{StaticResource DetailValueText}" Text="{Binding DetailUndoText}" />
                  <TextBlock Grid.Row="1" Style="{StaticResource DetailKeyText}" Text="Identyfikator" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValueText}" Text="{Binding Id}"
                             ToolTip="{Binding Id}" />
                </Grid>
                <TextBlock Style="{StaticResource DetailBodyText}" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Description}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- Stały pasek akcji serii nad dziennikiem: stała wysokość, tylko na stronach kategorii; przyciski nieaktywne przy 0 zaznaczonych.
         W wierszu treści przy dolnej krawędzi, żeby uchwyt dziennika sąsiadował z wierszem „*” (GridSplitter zmienia sąsiednie wiersze).
         Dolny margines 8: uchwyt nie przykleja się do paska. Obramowanie „L” w kolorze marki: lewa 3 px + dolna 1 px
         (wybór Dawida z czterech renderowanych wariantów, 2026-10-21). -->
    <Border Grid.Row="2" Grid.Column="1" Height="56" Margin="22,0,16,8" Padding="14,0,12,0" VerticalAlignment="Bottom"
            BorderThickness="3,0,0,1" BorderBrush="{DynamicResource BrandAccentBrush}"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
            Visibility="{Binding IsCategorySelected, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding SelectionBarTitle}"
                     ToolTip="{Binding SelectionBarTitle}" />
          <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding SelectionBarDetails}"
                     ToolTip="{Binding SelectionBarDetails}">
            <TextBlock.Style>
              <!-- Gdy nic nie zaznaczono: bez pustej podpowiedzi i bez pustej linii (tekst zachęty wyśrodkowany w pasku) -->
              <Style TargetType="TextBlock" BasedOn="{StaticResource SubText}">
                <Style.Triggers>
                  <Trigger Property="Text" Value="">
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="1" Margin="12,0,12,0" Style="{StaticResource TextLinkButton}" Content="Odznacz wszystko"
                Command="{Binding ClearSelectionCommand}" />
        <Button Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                Content="{Binding UndoSelectedText}" Command="{Binding UndoSelectedCommand}" />
        <Button Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                Content="{Binding ApplySelectedText}" Command="{Binding ApplySelectedCommand}" />
      </Grid>
    </Border>

    <!-- Uchwyt wysokości dziennika (linia podziału nad nagłówkiem); wysokość nie jest zapamiętywana -->
    <GridSplitter Grid.Row="3" Grid.Column="1" Margin="22,0,16,0" Style="{StaticResource LogSplitter}"
                  AutomationProperties.Name="Wysokość dziennika" />

    <!-- Dziennik: zawsze widoczny, tekst do zaznaczania (LogView), przewija do najnowszej linii -->
    <DockPanel Grid.Row="4" Grid.Column="1" Margin="22,8,16,10">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Dziennik" />
        <TextBlock Grid.Column="1" Style="{StaticResource SubText}" VerticalAlignment="Center" Text="{Binding LogSummary}" />
        <Button Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource TextLinkButton}" Content="Kopiuj wszystko"
                Tag="Copy" Click="OnCopyLogClick" />
      </Grid>
      <!-- Prawy klik: Kopiuj, Kopiuj cały dziennik, na linii ze ścieżką Kopiuj ścieżkę, na linku Otwórz lokalizację pliku -->
      <RichTextBox x:Name="LogBox" Style="{StaticResource LogTextBox}" AutomationProperties.Name="Dziennik" />
    </DockPanel>
  </Grid>
</ui:FluentWindow>
