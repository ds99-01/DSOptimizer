[
  {
    "id": "disk.hibernation",
    "aliases": [
      "io_hiber"
    ],
    "category": "disk",
    "kind": "tweak",
    "title": "Wyłącz hibernację",
    "summary": "Wyłącza hibernację i usuwa plik hibernacji z dysku C: – Szybkie uruchamianie przestaje działać.",
    "benefit": "Odzyskujesz miejsce na dysku C: zajmowane przez plik hibernacji.",
    "description": "Wywołuje powercfg /hibernate off. Stan jest odczytywany przez udokumentowane API zasilania (CallNtPowerInformation, SYSTEM_POWER_CAPABILITIES) i wartość HibernateEnabled, bez parsowania tekstu. Na sprzęcie bez obsługi hibernacji pozycja jest niedostępna i niczego nie zapisuje. Bez hibernacji nie działa też hybrydowy stan uśpienia. Cofnięcie (powercfg /hibernate on) włącza hibernację z domyślnymi ustawieniami, jeśli była włączona przed zmianą.",
    "risk": "experimental",
    "scope": "machine",
    "warnings": [
      "Na laptopach znika hibernacja i Szybkie uruchamianie, a rozładowanie baterii w uśpieniu grozi utratą niezapisanych danych."
    ],
    "script": {
      "detect": [
        "if (-not (Get-Command Get-DsoPowerCaps -ErrorAction SilentlyContinue)) {",
        "    # Haczyk testowy: testy jednostkowe definiują te funkcje wcześniej jako mocki.",
        "    Add-Type -Namespace Dso -Name Power -MemberDefinition '[DllImport(\"powrprof.dll\")] public static extern uint CallNtPowerInformation(int level, IntPtr input, uint inputLength, byte[] output, uint outputLength);'",
        "    function Get-DsoPowerCaps {",
        "        # POWER_INFORMATION_LEVEL SystemPowerCapabilities = 4; SYSTEM_POWER_CAPABILITIES (MS Learn): bajt 6 = SystemS4, bajt 8 = HiberFilePresent.",
        "        $buffer = New-Object byte[] 256",
        "        $status = [Dso.Power]::CallNtPowerInformation(4, [IntPtr]::Zero, 0, $buffer, 256)",
        "        if ($status -ne 0) { throw ('CallNtPowerInformation (SystemPowerCapabilities) zwróciło NTSTATUS 0x{0:X8}.' -f $status) }",
        "        [pscustomobject]@{ S4 = [bool]$buffer[6]; HiberFilePresent = [bool]$buffer[8] }",
        "    }",
        "    function Get-DsoHibernateEnabled {",
        "        [Microsoft.Win32.Registry]::GetValue('HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Power', 'HibernateEnabled', $null)",
        "    }",
        "}",
        "function Get-DsoHibernationState {",
        "    $caps = Get-DsoPowerCaps",
        "    $value = Get-DsoHibernateEnabled",
        "    $off = ($null -ne $value) -and ([int]$value -eq 0)",
        "    if ($off -and -not $caps.HiberFilePresent) { return 'Applied' }",
        "    if ($caps.S4 -or $caps.HiberFilePresent -or $off) { return 'NotApplied' }",
        "    return 'NotSupported'",
        "}",
        "",
        "Get-DsoHibernationState"
      ],
      "capture": [
        "if (-not (Get-Command Get-DsoPowerCaps -ErrorAction SilentlyContinue)) {",
        "    # Haczyk testowy: testy jednostkowe definiują te funkcje wcześniej jako mocki.",
        "    Add-Type -Namespace Dso -Name Power -MemberDefinition '[DllImport(\"powrprof.dll\")] public static extern uint CallNtPowerInformation(int level, IntPtr input, uint inputLength, byte[] output, uint outputLength);'",
        "    function Get-DsoPowerCaps {",
        "        # POWER_INFORMATION_LEVEL SystemPowerCapabilities = 4; SYSTEM_POWER_CAPABILITIES (MS Learn): bajt 6 = SystemS4, bajt 8 = HiberFilePresent.",
        "        $buffer = New-Object byte[] 256",
        "        $status = [Dso.Power]::CallNtPowerInformation(4, [IntPtr]::Zero, 0, $buffer, 256)",
        "        if ($status -ne 0) { throw ('CallNtPowerInformation (SystemPowerCapabilities) zwróciło NTSTATUS 0x{0:X8}.' -f $status) }",
        "        [pscustomobject]@{ S4 = [bool]$buffer[6]; HiberFilePresent = [bool]$buffer[8] }",
        "    }",
        "    function Get-DsoHibernateEnabled {",
        "        [Microsoft.Win32.Registry]::GetValue('HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Power', 'HibernateEnabled', $null)",
        "    }",
        "}",
        "function Get-DsoHibernationState {",
        "    $caps = Get-DsoPowerCaps",
        "    $value = Get-DsoHibernateEnabled",
        "    $off = ($null -ne $value) -and ([int]$value -eq 0)",
        "    if ($off -and -not $caps.HiberFilePresent) { return 'Applied' }",
        "    if ($caps.S4 -or $caps.HiberFilePresent -or $off) { return 'NotApplied' }",
        "    return 'NotSupported'",
        "}",
        "",
        "switch (Get-DsoHibernationState) {",
        "    'Applied' { 'Disabled' }",
        "    'NotSupported' { 'Unsupported' }",
        "    default {",
        "        # NotApplied: hibernację uznajemy za włączoną tylko z dowodem (plik hibernacji obecny, HibernateEnabled różne od 0).",
        "        $caps = Get-DsoPowerCaps",
        "        $value = Get-DsoHibernateEnabled",
        "        $off = ($null -ne $value) -and ([int]$value -eq 0)",
        "        if ($caps.HiberFilePresent -and -not $off) { 'Enabled' }",
        "        else { throw 'Brak jednoznacznego dowodu stanu hibernacji (SystemS4 bez pliku hibernacji i bez jawnego HibernateEnabled = 0, albo plik hibernacji przy HibernateEnabled = 0) – nic nie zmieniono.' }",
        "    }",
        "}"
      ],
      "apply": [
        "if (-not (Get-Command Get-DsoPowerCaps -ErrorAction SilentlyContinue)) {",
        "    # Haczyk testowy: testy jednostkowe definiują te funkcje wcześniej jako mocki.",
        "    Add-Type -Namespace Dso -Name Power -MemberDefinition '[DllImport(\"powrprof.dll\")] public static extern uint CallNtPowerInformation(int level, IntPtr input, uint inputLength, byte[] output, uint outputLength);'",
        "    function Get-DsoPowerCaps {",
        "        # POWER_INFORMATION_LEVEL SystemPowerCapabilities = 4; SYSTEM_POWER_CAPABILITIES (MS Learn): bajt 6 = SystemS4, bajt 8 = HiberFilePresent.",
        "        $buffer = New-Object byte[] 256",
        "        $status = [Dso.Power]::CallNtPowerInformation(4, [IntPtr]::Zero, 0, $buffer, 256)",
        "        if ($status -ne 0) { throw ('CallNtPowerInformation (SystemPowerCapabilities) zwróciło NTSTATUS 0x{0:X8}.' -f $status) }",
        "        [pscustomobject]@{ S4 = [bool]$buffer[6]; HiberFilePresent = [bool]$buffer[8] }",
        "    }",
        "    function Get-DsoHibernateEnabled {",
        "        [Microsoft.Win32.Registry]::GetValue('HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Power', 'HibernateEnabled', $null)",
        "    }",
        "}",
        "function Get-DsoHibernationState {",
        "    $caps = Get-DsoPowerCaps",
        "    $value = Get-DsoHibernateEnabled",
        "    $off = ($null -ne $value) -and ([int]$value -eq 0)",
        "    if ($off -and -not $caps.HiberFilePresent) { return 'Applied' }",
        "    if ($caps.S4 -or $caps.HiberFilePresent -or $off) { return 'NotApplied' }",
        "    return 'NotSupported'",
        "}",
        "function Invoke-DsoPowercfg([string]$Mode) {",
        "    $ErrorActionPreference = 'Continue'",
        "    $output = & powercfg.exe /hibernate $Mode 2>&1",
        "    $code = $LASTEXITCODE",
        "    $output | ForEach-Object { \"$_\" }",
        "    if ($code -ne 0) { throw \"powercfg /hibernate $Mode zakończył się kodem $code.\" }",
        "}",
        "$state = Get-DsoHibernationState",
        "if ($state -eq 'Applied') { 'Hibernacja jest już wyłączona.'; exit 0 }",
        "if ($state -ne 'NotApplied') { throw 'Ten sprzęt lub firmware nie obsługuje hibernacji (SystemS4 = false) – nic nie zmieniono.' }",
        "Invoke-DsoPowercfg 'off'",
        "$after = Get-DsoHibernationState",
        "if ($after -ne 'Applied') { throw \"Po powercfg /hibernate off stan hibernacji to $after zamiast Applied.\" }",
        "'Hibernacja wyłączona.'"
      ],
      "undo": [
        "if (-not (Get-Command Get-DsoPowerCaps -ErrorAction SilentlyContinue)) {",
        "    # Haczyk testowy: testy jednostkowe definiują te funkcje wcześniej jako mocki.",
        "    Add-Type -Namespace Dso -Name Power -MemberDefinition '[DllImport(\"powrprof.dll\")] public static extern uint CallNtPowerInformation(int level, IntPtr input, uint inputLength, byte[] output, uint outputLength);'",
        "    function Get-DsoPowerCaps {",
        "        # POWER_INFORMATION_LEVEL SystemPowerCapabilities = 4; SYSTEM_POWER_CAPABILITIES (MS Learn): bajt 6 = SystemS4, bajt 8 = HiberFilePresent.",
        "        $buffer = New-Object byte[] 256",
        "        $status = [Dso.Power]::CallNtPowerInformation(4, [IntPtr]::Zero, 0, $buffer, 256)",
        "        if ($status -ne 0) { throw ('CallNtPowerInformation (SystemPowerCapabilities) zwróciło NTSTATUS 0x{0:X8}.' -f $status) }",
        "        [pscustomobject]@{ S4 = [bool]$buffer[6]; HiberFilePresent = [bool]$buffer[8] }",
        "    }",
        "    function Get-DsoHibernateEnabled {",
        "        [Microsoft.Win32.Registry]::GetValue('HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Power', 'HibernateEnabled', $null)",
        "    }",
        "}",
        "function Get-DsoHibernationState {",
        "    $caps = Get-DsoPowerCaps",
        "    $value = Get-DsoHibernateEnabled",
        "    $off = ($null -ne $value) -and ([int]$value -eq 0)",
        "    if ($off -and -not $caps.HiberFilePresent) { return 'Applied' }",
        "    if ($caps.S4 -or $caps.HiberFilePresent -or $off) { return 'NotApplied' }",
        "    return 'NotSupported'",
        "}",
        "function Invoke-DsoPowercfg([string]$Mode) {",
        "    $ErrorActionPreference = 'Continue'",
        "    $output = & powercfg.exe /hibernate $Mode 2>&1",
        "    $code = $LASTEXITCODE",
        "    $output | ForEach-Object { \"$_\" }",
        "    if ($code -ne 0) { throw \"powercfg /hibernate $Mode zakończył się kodem $code.\" }",
        "}",
        "switch ($Snapshot) {",
        "    'Enabled' {",
        "        # Ten sam dowód co w capture: plik hibernacji obecny i HibernateEnabled różne od 0.",
        "        function Test-DsoHibernationEnabled {",
        "            $value = Get-DsoHibernateEnabled",
        "            $off = ($null -ne $value) -and ([int]$value -eq 0)",
        "            (Get-DsoPowerCaps).HiberFilePresent -and -not $off",
        "        }",
        "        if (Test-DsoHibernationEnabled) { 'Hibernacja jest już włączona – nic do przywrócenia.' }",
        "        else {",
        "            Invoke-DsoPowercfg 'on'",
        "            if (-not (Test-DsoHibernationEnabled)) { throw 'Po powercfg /hibernate on brak dowodu włączonej hibernacji (plik hibernacji i HibernateEnabled różne od 0).' }",
        "            'Hibernacja przywrócona.'",
        "        }",
        "    }",
        "    'Disabled' { 'Hibernacja była wyłączona przed zmianą – nic do przywrócenia.' }",
        "    'Unsupported' { 'Sprzęt nie obsługiwał hibernacji przed zmianą – nic do przywrócenia.' }",
        "    default { throw \"Brak znanego snapshotu hibernacji (otrzymano: '$Snapshot') – nie wiadomo, czy ją włączyć.\" }",
        "}"
      ]
    }
  },
  {
    "id": "disk.ntfs-last-access",
    "aliases": [],
    "category": "disk",
    "kind": "tweak",
    "title": "Wyłącz zapisywanie czasu ostatniego dostępu do plików",
    "summary": "Windows przestaje zapisywać, kiedy ostatnio otwarto każdy plik.",
    "benefit": "Dysk dostaje mniej drobnych zapisów przy każdym otwarciu pliku.",
    "description": "NtfsDisableLastAccessUpdate = 0x80000001 (tryb zarządzany przez użytkownika, aktualizacje wyłączone) zamiast domyślnego 0x80000002 (zarządzany przez system, aktualizacje włączone) w HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem – tę samą wartość zapisuje fsutil behavior set disablelastaccess 1. Stan jest odczytywany z dolnych 2 bitów wartości: tryby 1 i 3 oznaczają zastosowaną zmianę. Microsoft wymaga restartu, choć samo fsutil podaje, że zmiana działa od razu. Cofnięcie przywraca dokładnie poprzednią wartość albo jej brak.",
    "risk": "safe",
    "scope": "machine",
    "requiresReboot": true,
    "warnings": [
      "Wymaga restartu komputera.",
      "Programy korzystające z czasu ostatniego dostępu (kopie zapasowe, skrypty porządkujące) dostaną nieaktualne dane."
    ],
    "script": {
      "detect": [
        "if (-not (Get-Command Get-DsoLastAccessValue -ErrorAction SilentlyContinue)) {",
        "    # Haczyk testowy: testy jednostkowe definiują te funkcje wcześniej jako mocki. Cały dostęp do rejestru jest tylko w tym bloku (.NET, widok 64-bit).",
        "    function Open-DsoRegistryBase {",
        "        [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64)",
        "    }",
        "    function Get-DsoLastAccessValue {",
        "        # Zwraca $null (brak wartości) albo @{ Kind; Value }, gdzie Value to [uint32] dla DWord.",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem')",
        "            if ($null -eq $key) { return $null }",
        "            try {",
        "                if (@($key.GetValueNames()) -notcontains 'NtfsDisableLastAccessUpdate') { return $null }",
        "                $kind = $key.GetValueKind('NtfsDisableLastAccessUpdate')",
        "                $raw = $key.GetValue('NtfsDisableLastAccessUpdate', $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)",
        "                if ($kind -eq [Microsoft.Win32.RegistryValueKind]::DWord) { $raw = [BitConverter]::ToUInt32([BitConverter]::GetBytes([int]$raw), 0) }",
        "                [pscustomobject]@{ Kind = $kind.ToString(); Value = $raw }",
        "            }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "    function Set-DsoLastAccessValue([uint32]$Value) {",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem', $true)",
        "            if ($null -eq $key) { throw 'Brak klucza HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem.' }",
        "            try { $key.SetValue('NtfsDisableLastAccessUpdate', [BitConverter]::ToInt32([BitConverter]::GetBytes($Value), 0), [Microsoft.Win32.RegistryValueKind]::DWord) }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "    function Remove-DsoLastAccessValue {",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem', $true)",
        "            if ($null -eq $key) { throw 'Brak klucza HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem.' }",
        "            try { $key.DeleteValue('NtfsDisableLastAccessUpdate', $false) }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "}",
        "function Get-DsoLastAccessState {",
        "    # Tryb to dolne 2 bity (0x80000000 to stała flaga): 1 i 3 = aktualizacje wyłączone. Brak wartości lub inny typ niż DWord = NotApplied.",
        "    $current = Get-DsoLastAccessValue",
        "    if ($null -eq $current -or $current.Kind -ne 'DWord') { return 'NotApplied' }",
        "    if (([int64]$current.Value -band 3) -in 1, 3) { return 'Applied' }",
        "    'NotApplied'",
        "}",
        "",
        "Get-DsoLastAccessState"
      ],
      "capture": [
        "if (-not (Get-Command Get-DsoLastAccessValue -ErrorAction SilentlyContinue)) {",
        "    # Haczyk testowy: testy jednostkowe definiują te funkcje wcześniej jako mocki. Cały dostęp do rejestru jest tylko w tym bloku (.NET, widok 64-bit).",
        "    function Open-DsoRegistryBase {",
        "        [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64)",
        "    }",
        "    function Get-DsoLastAccessValue {",
        "        # Zwraca $null (brak wartości) albo @{ Kind; Value }, gdzie Value to [uint32] dla DWord.",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem')",
        "            if ($null -eq $key) { return $null }",
        "            try {",
        "                if (@($key.GetValueNames()) -notcontains 'NtfsDisableLastAccessUpdate') { return $null }",
        "                $kind = $key.GetValueKind('NtfsDisableLastAccessUpdate')",
        "                $raw = $key.GetValue('NtfsDisableLastAccessUpdate', $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)",
        "                if ($kind -eq [Microsoft.Win32.RegistryValueKind]::DWord) { $raw = [BitConverter]::ToUInt32([BitConverter]::GetBytes([int]$raw), 0) }",
        "                [pscustomobject]@{ Kind = $kind.ToString(); Value = $raw }",
        "            }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "    function Set-DsoLastAccessValue([uint32]$Value) {",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem', $true)",
        "            if ($null -eq $key) { throw 'Brak klucza HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem.' }",
        "            try { $key.SetValue('NtfsDisableLastAccessUpdate', [BitConverter]::ToInt32([BitConverter]::GetBytes($Value), 0), [Microsoft.Win32.RegistryValueKind]::DWord) }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "    function Remove-DsoLastAccessValue {",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem', $true)",
        "            if ($null -eq $key) { throw 'Brak klucza HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem.' }",
        "            try { $key.DeleteValue('NtfsDisableLastAccessUpdate', $false) }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "}",
        "function Get-DsoLastAccessState {",
        "    # Tryb to dolne 2 bity (0x80000000 to stała flaga): 1 i 3 = aktualizacje wyłączone. Brak wartości lub inny typ niż DWord = NotApplied.",
        "    $current = Get-DsoLastAccessValue",
        "    if ($null -eq $current -or $current.Kind -ne 'DWord') { return 'NotApplied' }",
        "    if (([int64]$current.Value -band 3) -in 1, 3) { return 'Applied' }",
        "    'NotApplied'",
        "}",
        "",
        "$current = Get-DsoLastAccessValue",
        "if ($null -eq $current) { 'Absent'; exit 0 }",
        "if ($current.Kind -ne 'DWord') { throw \"NtfsDisableLastAccessUpdate ma typ $($current.Kind) zamiast DWord – nic nie zmieniono.\" }",
        "'DWord:{0}' -f [uint32]$current.Value"
      ],
      "apply": [
        "if (-not (Get-Command Get-DsoLastAccessValue -ErrorAction SilentlyContinue)) {",
        "    # Haczyk testowy: testy jednostkowe definiują te funkcje wcześniej jako mocki. Cały dostęp do rejestru jest tylko w tym bloku (.NET, widok 64-bit).",
        "    function Open-DsoRegistryBase {",
        "        [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64)",
        "    }",
        "    function Get-DsoLastAccessValue {",
        "        # Zwraca $null (brak wartości) albo @{ Kind; Value }, gdzie Value to [uint32] dla DWord.",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem')",
        "            if ($null -eq $key) { return $null }",
        "            try {",
        "                if (@($key.GetValueNames()) -notcontains 'NtfsDisableLastAccessUpdate') { return $null }",
        "                $kind = $key.GetValueKind('NtfsDisableLastAccessUpdate')",
        "                $raw = $key.GetValue('NtfsDisableLastAccessUpdate', $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)",
        "                if ($kind -eq [Microsoft.Win32.RegistryValueKind]::DWord) { $raw = [BitConverter]::ToUInt32([BitConverter]::GetBytes([int]$raw), 0) }",
        "                [pscustomobject]@{ Kind = $kind.ToString(); Value = $raw }",
        "            }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "    function Set-DsoLastAccessValue([uint32]$Value) {",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem', $true)",
        "            if ($null -eq $key) { throw 'Brak klucza HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem.' }",
        "            try { $key.SetValue('NtfsDisableLastAccessUpdate', [BitConverter]::ToInt32([BitConverter]::GetBytes($Value), 0), [Microsoft.Win32.RegistryValueKind]::DWord) }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "    function Remove-DsoLastAccessValue {",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem', $true)",
        "            if ($null -eq $key) { throw 'Brak klucza HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem.' }",
        "            try { $key.DeleteValue('NtfsDisableLastAccessUpdate', $false) }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "}",
        "function Get-DsoLastAccessState {",
        "    # Tryb to dolne 2 bity (0x80000000 to stała flaga): 1 i 3 = aktualizacje wyłączone. Brak wartości lub inny typ niż DWord = NotApplied.",
        "    $current = Get-DsoLastAccessValue",
        "    if ($null -eq $current -or $current.Kind -ne 'DWord') { return 'NotApplied' }",
        "    if (([int64]$current.Value -band 3) -in 1, 3) { return 'Applied' }",
        "    'NotApplied'",
        "}",
        "",
        "if ((Get-DsoLastAccessState) -eq 'Applied') { 'Aktualizacje czasu ostatniego dostępu są już wyłączone.'; exit 0 }",
        "# 0x80000001 (2147483649): to samo, co zapisuje `fsutil behavior set disablelastaccess 1`.",
        "Set-DsoLastAccessValue 2147483649",
        "$after = Get-DsoLastAccessState",
        "if ($after -ne 'Applied') { throw \"Po zapisie NtfsDisableLastAccessUpdate stan to $after zamiast Applied.\" }",
        "'Wyłączono aktualizację czasu ostatniego dostępu (NtfsDisableLastAccessUpdate = 0x80000001); pełny skutek po restarcie.'"
      ],
      "undo": [
        "if (-not (Get-Command Get-DsoLastAccessValue -ErrorAction SilentlyContinue)) {",
        "    # Haczyk testowy: testy jednostkowe definiują te funkcje wcześniej jako mocki. Cały dostęp do rejestru jest tylko w tym bloku (.NET, widok 64-bit).",
        "    function Open-DsoRegistryBase {",
        "        [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64)",
        "    }",
        "    function Get-DsoLastAccessValue {",
        "        # Zwraca $null (brak wartości) albo @{ Kind; Value }, gdzie Value to [uint32] dla DWord.",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem')",
        "            if ($null -eq $key) { return $null }",
        "            try {",
        "                if (@($key.GetValueNames()) -notcontains 'NtfsDisableLastAccessUpdate') { return $null }",
        "                $kind = $key.GetValueKind('NtfsDisableLastAccessUpdate')",
        "                $raw = $key.GetValue('NtfsDisableLastAccessUpdate', $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)",
        "                if ($kind -eq [Microsoft.Win32.RegistryValueKind]::DWord) { $raw = [BitConverter]::ToUInt32([BitConverter]::GetBytes([int]$raw), 0) }",
        "                [pscustomobject]@{ Kind = $kind.ToString(); Value = $raw }",
        "            }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "    function Set-DsoLastAccessValue([uint32]$Value) {",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem', $true)",
        "            if ($null -eq $key) { throw 'Brak klucza HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem.' }",
        "            try { $key.SetValue('NtfsDisableLastAccessUpdate', [BitConverter]::ToInt32([BitConverter]::GetBytes($Value), 0), [Microsoft.Win32.RegistryValueKind]::DWord) }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "    function Remove-DsoLastAccessValue {",
        "        $base = Open-DsoRegistryBase",
        "        try {",
        "            $key = $base.OpenSubKey('SYSTEM\\CurrentControlSet\\Control\\FileSystem', $true)",
        "            if ($null -eq $key) { throw 'Brak klucza HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem.' }",
        "            try { $key.DeleteValue('NtfsDisableLastAccessUpdate', $false) }",
        "            finally { $key.Dispose() }",
        "        }",
        "        finally { $base.Dispose() }",
        "    }",
        "}",
        "function Get-DsoLastAccessState {",
        "    # Tryb to dolne 2 bity (0x80000000 to stała flaga): 1 i 3 = aktualizacje wyłączone. Brak wartości lub inny typ niż DWord = NotApplied.",
        "    $current = Get-DsoLastAccessValue",
        "    if ($null -eq $current -or $current.Kind -ne 'DWord') { return 'NotApplied' }",
        "    if (([int64]$current.Value -band 3) -in 1, 3) { return 'Applied' }",
        "    'NotApplied'",
        "}",
        "",
        "$wanted = $null",
        "if ($Snapshot -ne 'Absent') {",
        "    $parsed = [uint32]0",
        "    if (-not ($Snapshot -match '^DWord:([0-9]{1,10})$') -or -not [uint32]::TryParse($Matches[1], [ref]$parsed)) {",
        "        throw \"Brak poprawnego snapshotu NtfsDisableLastAccessUpdate (otrzymano: '$Snapshot').\"",
        "    }",
        "    $wanted = $parsed",
        "}",
        "$current = Get-DsoLastAccessValue",
        "if ($null -eq $wanted) {",
        "    if ($null -eq $current) { 'NtfsDisableLastAccessUpdate nie istniał przed zmianą i nie istnieje – nic do przywrócenia.'; exit 0 }",
        "    Remove-DsoLastAccessValue",
        "    if ($null -ne (Get-DsoLastAccessValue)) { throw 'Po usunięciu NtfsDisableLastAccessUpdate wartość nadal istnieje.' }",
        "    'NtfsDisableLastAccessUpdate usunięty (jak przed zmianą).'",
        "}",
        "else {",
        "    if ($null -ne $current -and $current.Kind -eq 'DWord' -and [uint32]$current.Value -eq $wanted) { \"NtfsDisableLastAccessUpdate ma już wartość $wanted – nic do przywrócenia.\"; exit 0 }",
        "    Set-DsoLastAccessValue $wanted",
        "    $after = Get-DsoLastAccessValue",
        "    if ($null -eq $after -or $after.Kind -ne 'DWord' -or [uint32]$after.Value -ne $wanted) { throw \"Po zapisie NtfsDisableLastAccessUpdate nie ma wartości $wanted.\" }",
        "    \"NtfsDisableLastAccessUpdate przywrócony: $wanted.\"",
        "}"
      ]
    }
  },
