  {
    "id": "disk.reserved-storage",
    "aliases": [
      "sec_storage_reserve"
    ],
    "category": "disk",
    "kind": "tweak",
    "title": "Wyłącz rezerwę miejsca na aktualizacje",
    "summary": "Windows przestaje trzymać na dysku C: zarezerwowane miejsce na aktualizacje.",
    "benefit": "Odzyskujesz miejsce na dysku C:, które Windows trzyma na aktualizacje – kilka GB.",
    "description": "Set-WindowsReservedStorageState -State Disabled; stan jest odczytywany przez (Get-WindowsReservedStorageState).ReservedStorageState. W trakcie serwisowania systemu (oczekująca aktualizacja) operacja kończy się błędem z komunikatem Microsoftu i niczego nie zmienia. Cofnięcie przywraca poprzedni stan rezerwy; w rejestrze zostaje wtedy wartość ReserveManager\\MiscPolicyInfo, której wcześniej nie było.",
    "risk": "caution",
    "scope": "machine",
    "warnings": [
      "Przy małej ilości wolnego miejsca aktualizacje mogą częściej kończyć się błędem."
    ],
    "script": {
      "detect": [
        "if (-not (Get-Command Get-WindowsReservedStorageState -ErrorAction SilentlyContinue)) { 'NotSupported'; exit 0 }",
        "$state = (Get-WindowsReservedStorageState).ReservedStorageState.ToString()",
        "switch ($state) {",
        "    'Enabled' { 'NotApplied' }",
        "    'Disabled' { 'Applied' }",
        "    default { throw \"Nieznana wartość ReservedStorageState: '$state'.\" }",
        "}"
      ],
      "capture": [
        "$state = (Get-WindowsReservedStorageState).ReservedStorageState.ToString()",
        "if ($state -notin @('Enabled', 'Disabled')) { throw \"Nieznana wartość ReservedStorageState: '$state'.\" }",
        "$state"
      ],
      "apply": [
        "$null = Set-WindowsReservedStorageState -State Disabled",
        "$after = (Get-WindowsReservedStorageState).ReservedStorageState.ToString()",
        "if ($after -ne 'Disabled') { throw \"Po Set-WindowsReservedStorageState stan rezerwy miejsca to $after zamiast Disabled.\" }",
        "'Rezerwa miejsca wyłączona.'"
      ],
      "undo": [
        "if ($Snapshot -notin @('Enabled', 'Disabled')) { throw \"Brak poprawnego snapshotu rezerwy miejsca (otrzymano: '$Snapshot').\" }",
        "$current = (Get-WindowsReservedStorageState).ReservedStorageState.ToString()",
        "if ($current -eq $Snapshot) { \"Rezerwa miejsca ma już stan $Snapshot – nic do przywrócenia.\"; exit 0 }",
        "$null = Set-WindowsReservedStorageState -State $Snapshot",
        "$after = (Get-WindowsReservedStorageState).ReservedStorageState.ToString()",
        "if ($after -ne $Snapshot) { throw \"Po Set-WindowsReservedStorageState stan rezerwy miejsca to $after zamiast $Snapshot.\" }",
        "\"Rezerwa miejsca przywrócona: $after.\""
      ]
    }
  }
