      "id": "steam",
      "match": { "file": "steam.exe", "folders": ["%ProgramFiles(x86)%\\Steam\\"], "publishers": ["Valve Corporation"], "valueName": "Steam" },
      "verdict": "can-disable",
      "summary": "Klient Steam uruchamiany po zalogowaniu. Po wyłączeniu nie startuje sam, a gry i ich aktualizacje są dostępne po ręcznym otwarciu Steama.",
