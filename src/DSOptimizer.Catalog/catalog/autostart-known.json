        "docs/zrodla/2026-11-02-autostart-programy.md",
        "https://blog.pcrisk.com/windows/13714-stop-steam-from-opening-on-startup",
        "https://helpdeskgeek.com/how-to-stop-steam-from-opening-on-startup/"
      ],
      "confirmed": true
    },
